# Independent native input for semantic import packet acceptance. Synthetic addresses only.
table inet nergal_filter {
    chain rpfilter {
        type filter hook prerouting priority raw; policy accept;
        ip6 saddr fe80::/10 accept
        udp sport 68 accept
        fib saddr . iif oif == 0 drop
    }
    chain input {
        type filter hook input priority 0; policy drop;
        meta nfproto ipv4 udp dport 19000 accept
        meta nfproto ipv6 meta l4proto ipv6-icmp accept
    }
    chain forward {
        type filter hook forward priority 0; policy drop;
        tcp flags syn tcp option maxseg size set 1360
        ct state established,related accept
        ether saddr 02:00:00:00:00:01 ip saddr 192.0.2.2 tcp dport 9001 accept
        ether saddr 02:00:00:00:00:01 ip6 saddr 2001:db8:1::2 tcp dport 9001 accept
        udp dport 19001 meter destination4 { ip daddr timeout 60s limit rate 1/minute burst 1 packets } accept
        udp dport 19001 meter destination6 { ip6 daddr timeout 60s limit rate 1/minute burst 1 packets } accept
    }
    chain output { type filter hook output priority 0; policy accept; }
}

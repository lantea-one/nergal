# Ordered NAT exemptions and dual-stack masquerade; never used in a host namespace.
table inet nergal_nat {
    chain prerouting { type nat hook prerouting priority dstnat; policy accept; }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        ip daddr {198.51.100.3,198.51.100.99} return
        ip6 daddr {2001:db8:2::3,2001:db8:2::99} return
        iifname "lan0" oifname "wan0" ip saddr {192.0.2.2,192.0.2.90} ip daddr {198.51.100.2/31,198.51.100.10} tcp dport 9001 masquerade
        iifname "lan0" oifname "wan0" ip6 saddr {2001:db8:1::2,2001:db8:1::90} ip6 daddr {2001:db8:2::2/127,2001:db8:2::10} tcp dport 9001 masquerade
    }
}

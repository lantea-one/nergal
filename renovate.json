{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "packageRules": [
    {
      "description": "Stay on .NET 10 LTS SDK and 10.x runtime/framework servicing updates",
      "matchPackageNames": [
        "dotnet-sdk",
        "Microsoft.Data.Sqlite",
        "/^Microsoft\\.AspNetCore\\./",
        "/^Microsoft\\.EntityFrameworkCore\\./"
      ],
      "allowedVersions": "<11.0.0"
    },
    {
      "description": "Keep .NET container runtimes aligned with the pinned .NET 10 application target",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mcr.microsoft.com/dotnet/aspnet",
        "mcr.microsoft.com/dotnet/sdk",
        "mcr.microsoft.com/dotnet/runtime"
      ],
      "allowedVersions": "/^10\\./"
    }
  ],
  "dependencyDashboard": {
    "autoclose": true
  }
}

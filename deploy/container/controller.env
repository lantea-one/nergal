# Nonsecret defaults for the loopback Compose deployment.
AllowedHosts=127.0.0.1;localhost

# For a separately installed host agent using pinned TLS 1.3 mTLS, mount the
# dedicated controller client certificate and its 0600 key with the credentials.
# ControllerState__TlsClientCertificatePath=/etc/nergal/credentials/agent-client.crt
# ControllerState__TlsClientKeyPath=/etc/nergal/credentials/agent-client.key

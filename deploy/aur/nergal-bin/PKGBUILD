# Maintainer: Nergal maintainers <noreply@lantea.one>
pkgname=nergal-bin
pkgver=2026.11.21.1
pkgrel=1
_tag=2026.11.21.1
pkgdesc='Self-hosted native nftables firewall controller and host agent (binary release)'
arch=('x86_64')
url='https://git.lantea.one/lantea-one/nergal'
license=('MIT')
depends=('dotnet-runtime-10.0' 'aspnet-runtime-10.0' 'nftables' 'systemd')
provides=("nergal=$pkgver")
conflicts=('nergal')
options=('!strip' '!debug')

_archive="nergal_${pkgver}_linux-x64.tar.gz"
source=("$url/releases/download/$_tag/$_archive"
        "LICENSE-$pkgver::$url/raw/tag/$_tag/LICENSE")
noextract=("$_archive")
sha256sums=('e47389cad66ef28b7981fa1fd48367652f599a05e6f1e4a25d0875920c11761c'
            'f1c058baea1fd07af810900a59dff4a6bfd65ee4843ad8316081b440c76edefa')

package() {
    tar --no-same-owner -xzf "$srcdir/$_archive" -C "$pkgdir"
    # The first published bundle used local installation paths. Pacman owns
    # executable and vendor unit files under /usr.
    if [[ -d "$pkgdir/usr/local/sbin" ]]; then
        install -d "$pkgdir/usr/bin"
        mv "$pkgdir/usr/local/sbin/"nergal-{admin,agent} "$pkgdir/usr/bin/"
        rmdir "$pkgdir/usr/local/sbin" "$pkgdir/usr/local"
    fi
    if [[ -d "$pkgdir/etc/systemd/system" ]]; then
        install -d "$pkgdir/usr/lib/systemd/system"
        mv "$pkgdir/etc/systemd/system/"nergal-{agent,web}.service "$pkgdir/usr/lib/systemd/system/"
        rmdir "$pkgdir/etc/systemd/system" "$pkgdir/etc/systemd" "$pkgdir/etc"
    fi
    install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

[Unit]
Description=nergal web firewall controller
Documentation=https://git.lantea.one/lantea-one/nergal/src/branch/main/docs/deployment.md
After=network-online.target nergal-agent.service
Wants=network-online.target

[Service]
Type=simple
User=nergal-web
Group=nergal-web
SupplementaryGroups=nergal-ctl
WorkingDirectory=/var/lib/nergal/web
EnvironmentFile=/etc/nergal/web/env
ExecStart=/usr/bin/dotnet /opt/nergal/web/Nergal.Web.dll
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s

# Controller web UI holds zero kernel firewall or Docker capabilities.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/nergal/web /etc/nergal/web
ReadWritePaths=/var/lib/nergal/web
UMask=0077

[Install]
WantedBy=multi-user.target

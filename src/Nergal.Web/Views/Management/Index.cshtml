@model Nergal.Web.FleetDashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Overview";
    ViewData["ActiveNav"] = "fleet";
    ViewData["ActorRole"] = Model.ActorRole;
    ViewData["ShowManageNav"] = true;
    var next = Model.NextAction;
    var actionUrl = next.Destination switch
    {
        Nergal.Web.DashboardDestination.Hosts => Url.Action("Hosts"),
        Nergal.Web.DashboardDestination.Apply => Url.Action("Apply", new { hostId = next.HostId }),
        Nergal.Web.DashboardDestination.Audit => Url.Action("Audit"),
        _ => Url.Action("Policies"),
    };
    var attention = Model.HostHealth.Count(h => h.StateLabel is "drift" or "missing" or "pending");
    var checkedHosts = Model.HostHealth.Count(h => h.Reachable);
}
<main class="container" id="main-content" tabindex="-1">
    <div class="page-header"><div><p class="eyebrow">@Model.Settings.Branding.InstanceSubtitle</p><h1>Overview</h1>
        <p class="page-subtitle">Firewall configuration, connected hosts and recent activity.</p></div><span class="badge badge-neutral">Native nftables</span></div>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    { <p class="alert alert-danger" role="alert">@Model.ErrorMessage</p> }
    <section class="card next-action" aria-labelledby="next-action-heading">
        <div><p class="eyebrow">@(attention > 0 ? "Needs attention" : "Next action")</p><h2 id="next-action-heading">@next.Heading</h2><p>@next.Description</p>
            <div class="btn-group"><a class="btn" href="@actionUrl">@next.Label</a>
            @if (Model.CanMutate && Model.LatestRevision is null)
            { <a class="btn btn-secondary" href="@Url.Action("Sources")">Import nftables.conf</a> }
            </div>
        </div>
        <ol class="configuration-steps" aria-label="Configuration workflow">
            <li><span class="step-number">1</span><div><strong>Prepare a policy</strong><span>@(Model.LatestRevision is null ? "Create rules or import a configuration" : $"Revision {Model.LatestRevision.Revision} saved")</span></div></li>
            <li><span class="step-number">2</span><div><strong>Connect a host</strong><span>@(Model.Hosts.Count == 0 ? "Register an enrolled agent" : $"{Model.Hosts.Count} registered connections")</span></div></li>
            <li><span class="step-number">3</span><div><strong>Review and apply</strong><span>Inspect changes, apply, then confirm</span></div></li>
        </ol>
    </section>
    <div class="overview-grid">
        <section class="card" aria-labelledby="configuration-heading"><div class="card-header"><h2 id="configuration-heading">Saved configuration</h2><a href="@Url.Action("Policies")">Open rules</a></div>
            @if (Model.LatestRevision is { } latest)
            {
                <p class="overview-number">Revision @latest.Revision</p><p>@(latest.Summary ?? "Saved policy revision")</p>
                <p class="hint">Saved @await Html.PartialAsync("_LocalTime", latest.CreatedAtUtc). Desired configuration may differ from the policy confirmed on each host.</p>
            }
            else { <p>No saved policy yet.</p><p class="hint">Use Firewall / Rules to create a policy, or Configuration / Import to start with a native file.</p> }
            <details class="disclosure"><summary>How configuration changes reach a host</summary><p>Rule edits change the draft. Saving creates an immutable revision. Review and apply sends an explicitly selected revision to an enrolled host; its local watchdog restores the previous policy if confirmation is missing.</p></details>
        </section>
        <section class="card" aria-labelledby="connections-heading"><div class="card-header"><h2 id="connections-heading">Host status</h2><a href="@Url.Action("Hosts")">Manage hosts</a></div>
            <p class="overview-number">@Model.Hosts.Count <span class="muted">registered</span></p>
            @if (Model.Hosts.Count == 0) { <p>No hosts connected.</p><p class="hint">You can prepare a policy first. Agent enrollment and connection registration establish the host's trust boundary.</p> }
            else
            {
                <p>@checkedHosts responded to this page's status query. @attention need confirmation or recovery review.</p>
                <ul class="host-status-list">
                @foreach (var health in Model.HostHealth.Take(5))
                { <li><a href="@Url.Action("Apply", new { hostId = health.Host.Id })">@health.Host.Name</a><span class="badge badge-neutral">@health.StateLabel</span></li> }
                </ul>
                @if (Model.Hosts.Count > 5) { <p class="hint">Showing 5 hosts. Open Hosts for all connections.</p> }
                <p class="hint">Matched means the observed agent baseline matches its receipt. It does not establish that the latest saved controller revision is applied. Unavailable means the status query failed; unqueried means no live check was made.</p>
            }
        </section>
    </div>
    <section class="card"><div class="card-header"><h2>Recent activity</h2><a href="@Url.Action("Audit")">Open audit log</a></div>
        @if (Model.RecentAudit.Count == 0) { <p class="muted">No configuration activity recorded yet.</p> }
        else
        {
            <div class="table-wrap"><table><caption class="visually-hidden">Latest five attributed events</caption><thead><tr><th>Time (local)</th><th>Action</th><th>Outcome</th></tr></thead><tbody>
            @foreach (var entry in Model.RecentAudit.Take(5))
            { <tr><td>@await Html.PartialAsync("_LocalTime", entry.TimestampUtc)</td><td><code>@entry.Action</code></td><td>@entry.Outcome</td></tr> }
            </tbody></table></div>
        }
    </section>
</main>

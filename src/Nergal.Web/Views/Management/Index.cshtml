@model Nergal.Web.FleetDashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveNav"] = "fleet";
    ViewData["ActorRole"] = Model.ActorRole;
    ViewData["ShowManageNav"] = true;

    var matchedCount = Model.HostHealth.Count(h => h.StateLabel is "matched" or "online");
    var driftCount = Model.HostHealth.Count(h => h.StateLabel is "drift" or "missing");
    var pendingCount = Model.HostHealth.Count(h => h.StateLabel == "pending");
    var unavailableCount = Model.HostHealth.Count(h => h.StateLabel == "unavailable");

    var filterRuleCount = Model.LatestBundle?.Filter.Rules.Count ?? 0;
    var dnatRuleCount = Model.LatestBundle?.Nat?.DnatRules.Count ?? 0;
    var snatRuleCount = Model.LatestBundle?.Nat?.SnatRules.Count ?? 0;
    var bridgeRuleCount = Model.LatestBundle?.Bridge?.Rules.Count ?? 0;
    var totalRuleCount = filterRuleCount + dnatRuleCount + snatRuleCount + bridgeRuleCount;

    var authMethods = new List<string>();
    if (Model.Settings.LocalAuth.Enabled) { authMethods.Add("Local"); }
    if (Model.Settings.Oidc.Enabled) { authMethods.Add("OIDC"); }
    if (Model.Settings.Ldap.Enabled) { authMethods.Add("LDAP"); }
}
<main class="container">
    <div class="page-header">
        <div>
            <h1>@Model.Settings.Branding.ApplicationName overview dashboard</h1>
            <p class="page-subtitle">@Model.Settings.Branding.InstanceSubtitle · Signed in as <code>@Model.ActorId</code> · Role <code>@Model.ActorRole</code></p>
        </div>
        <div class="btn-group">
            <a class="btn" href="@Url.Content("~/manage/policies")">Open Policy Builder</a>
            <a class="btn btn-secondary" href="@Url.Content("~/manage/apply")">Confirmed Apply</a>
            <a class="btn btn-secondary" href="@Url.Content("~/manage/settings")">System Settings</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-label">Fleet Health</div>
            <div class="kpi-value">@matchedCount / @Model.Hosts.Count</div>
            <div class="kpi-meta">
                <span class="badge badge-success">@matchedCount synced</span>
                @if (driftCount > 0) { <span class="badge badge-warning">@driftCount drift</span> }
                @if (pendingCount > 0) { <span class="badge badge-primary">@pendingCount pending</span> }
                @if (unavailableCount > 0) { <span class="badge badge-danger">@unavailableCount offline</span> }
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Active Policy Revision</div>
            @if (Model.LatestRevision is { } latest)
            {
                <div class="kpi-value">Rev @latest.Revision</div>
                <div class="kpi-meta">SHA-256 <code>@latest.CandidateDigest[..12]</code> · @Model.TotalRevisions total revisions</div>
            }
            else
            {
                <div class="kpi-value">—</div>
                <div class="kpi-meta">No policy revisions saved yet</div>
            }
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Compiled Rule Inventory</div>
            <div class="kpi-value">@totalRuleCount rules</div>
            <div class="kpi-meta">
                Filter <strong>@filterRuleCount</strong> · DNAT <strong>@dnatRuleCount</strong> · SNAT <strong>@snatRuleCount</strong> · Bridge <strong>@bridgeRuleCount</strong>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Audit Trail</div>
            <div class="kpi-value">@Model.RecentAudit.Count recent</div>
            <div class="kpi-meta"><a href="@Url.Content("~/manage/audit")">Inspect full append-only log →</a></div>
        </div>
    </div>

    <section class="card">
        <div class="card-header">
            <h2>System posture &amp; runtime configuration</h2>
            <a class="btn btn-secondary btn-sm" href="@Url.Content("~/manage/settings")">Configure system</a>
        </div>
        <div class="status-grid">
            <div class="status-tile">
                <div class="status-tile-title">Firewall Backend</div>
                <div class="status-tile-value">Native nftables</div>
                <div class="status-tile-meta">Schema v@(Model.Settings.FirewallDefaults.DefaultFilterSchemaVersion) · Watchdog default @(Model.Settings.FirewallDefaults.DefaultConfirmationTimeoutSeconds)s</div>
            </div>
            <div class="status-tile">
                <div class="status-tile-title">Authentication Providers</div>
                <div class="status-tile-value">@(authMethods.Count > 0 ? string.Join(" + ", authMethods) : "None")</div>
                <div class="status-tile-meta">Session timeout @(Model.Settings.LocalAuth.SessionIdleTimeoutMinutes)m · Lockout after @(Model.Settings.LocalAuth.LockoutMaxFailedAttempts) tries</div>
            </div>
            <div class="status-tile">
                <div class="status-tile-title">Controller Database</div>
                <div class="status-tile-value">@Model.Settings.Database.Provider.ToUpperInvariant()</div>
                <div class="status-tile-meta">@(Model.Settings.Database.Provider == "sqlite" ? "Protected local WAL store (0600)" : $"{Model.Settings.Database.Host ?? "unconfigured"}:{Model.Settings.Database.Port ?? 0}/{Model.Settings.Database.DatabaseName ?? "-"}")</div>
            </div>
            <div class="status-tile">
                <div class="status-tile-title">Default Policy Posture</div>
                @if (Model.LatestBundle is { } bundle)
                {
                    <div class="status-tile-value">in:@bundle.Filter.InputDefaultVerdict · fwd:@bundle.Filter.ForwardDefaultVerdict · out:@bundle.Filter.OutputDefaultVerdict</div>
                    <div class="status-tile-meta">NAT @(bundle.Nat is not null ? "enabled" : "disabled") · Bridge @(bundle.Bridge is not null ? "enabled" : "disabled")</div>
                }
                else
                {
                    <div class="status-tile-value">Not yet authored</div>
                    <div class="status-tile-meta"><a href="@Url.Content("~/manage/policies")">Create initial policy →</a></div>
                }
            </div>
        </div>
    </section>

    <section class="card">
        <div class="card-header">
            <h2>Managed hosts (@Model.Hosts.Count)</h2>
            @if (Model.Hosts.Count > 0)
            {
                <a class="btn btn-secondary btn-sm" href="@Url.Content("~/manage/apply")">Inspect live agent status</a>
            }
        </div>
        @if (Model.Hosts.Count == 0)
        {
            <p class="muted mb-0">No managed hosts registered yet. Register a Unix socket or TLS 1.3 pinned mTLS agent below.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Host Name</th>
                            <th>Live Status</th>
                            <th>Transport</th>
                            <th>Endpoint</th>
                            <th>Pin / Peer Identity</th>
                            <th>Revision</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var health in Model.HostHealth)
                        {
                            var host = health.Host;
                            var statusBadge = health.StateLabel switch
                            {
                                "matched" or "online" => "badge-success",
                                "pending" => "badge-primary",
                                "drift" or "missing" => "badge-warning",
                                "unavailable" => "badge-danger",
                                _ => "badge-neutral",
                            };
                            <tr>
                                <td><strong>@host.Name</strong></td>
                                <td>
                                    <span class="badge @statusBadge">@health.StateLabel</span>
                                    @if (!string.IsNullOrEmpty(health.ErrorCode))
                                    {
                                        <span class="muted">(@health.ErrorCode)</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(host.TransportKind == Nergal.Core.Controller.AgentTransportKind.Tls ? "badge-primary" : "badge-neutral")">
                                        @host.TransportKind
                                    </span>
                                </td>
                                <td><code>@host.Endpoint</code></td>
                                <td>
                                    <code>@(host.PinnedServerThumbprint is { Length: > 16 } pin
                                        ? pin[..16] + "…"
                                        : (host.PinnedServerThumbprint ?? ($"uid={host.ExpectedServerUserId?.ToString() ?? "-"}" + (host.SocketGroupId.HasValue ? $" gid={host.SocketGroupId}" : ""))))</code>
                                </td>
                                <td><span class="badge badge-neutral">rev @(health.ReportedRevision ?? host.LastKnownRevision)</span></td>
                                <td>
                                    <div class="btn-group">
                                        <a class="btn btn-secondary btn-sm" href="@Url.Content($"~/manage/apply?hostId={host.Id:D}")">Apply / Status</a>
                                        @if (Model.CanMutate)
                                        {
                                            <form class="inline-form" method="post" action="@Url.Content("~/manage/hosts/delete")">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@host.Id.ToString("D")" />
                                                <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (Model.CanMutate)
    {
        <section class="card">
            <div class="card-header">
                <h2>Register agent host</h2>
                <span class="badge badge-neutral">Administrator</span>
            </div>
            <form method="post" action="@Url.Content("~/manage/hosts/add")">
                @Html.AntiForgeryToken()
                <div class="form-grid">
                    <div class="field">
                        <label for="host-name">Host name</label>
                        <input id="host-name" type="text" name="name" placeholder="edge-gw-01" required maxlength="128" />
                    </div>
                    <div class="field">
                        <label for="host-transport">Transport</label>
                        <select id="host-transport" name="transportKind" data-transport-select>
                            <option value="tls">tls (Pinned TLS 1.3 mTLS)</option>
                            <option value="unix">unix (Local SO_PEERCRED socket)</option>
                        </select>
                    </div>
                    <div class="field span-2">
                        <label for="host-endpoint">Endpoint</label>
                        <input id="host-endpoint" type="text" name="endpoint" placeholder="192.0.2.10:8443 or /run/nergal/control.sock" required maxlength="512" />
                    </div>
                    <div class="field span-2" data-transport-only="tls">
                        <label for="host-pin">Pinned Server SHA-256 Thumbprint (64 hex chars)</label>
                        <input id="host-pin" type="text" name="pinnedServerThumbprint" placeholder="64 lowercase hex characters" maxlength="64" />
                    </div>
                    <div class="field" data-transport-only="unix">
                        <label for="host-uid">Expected Server UID</label>
                        <input id="host-uid" type="text" name="expectedServerUserId" placeholder="0" />
                    </div>
                    <div class="field" data-transport-only="unix">
                        <label for="host-gid">Socket Group ID (optional)</label>
                        <input id="host-gid" type="text" name="socketGroupId" placeholder="nergal-ctl GID" />
                    </div>
                </div>
                <div class="mt-2">
                    <button type="submit">Register host</button>
                </div>
            </form>
        </section>
    }

    <section class="card">
        <div class="card-header">
            <h2>Recent audit activity</h2>
            <a class="btn btn-secondary btn-sm" href="@Url.Content("~/manage/audit")">Full audit log</a>
        </div>
        @if (Model.RecentAudit.Count == 0)
        {
            <p class="muted mb-0">No audit records yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Seq</th>
                            <th>Timestamp (UTC)</th>
                            <th>Actor</th>
                            <th>Action</th>
                            <th>Target</th>
                            <th>Outcome</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.RecentAudit)
                        {
                            var badge = entry.Outcome is "confirmed" or "saved" or "registered" or "ok" or "matched" or "succeeded"
                                ? "badge-success"
                                : entry.Outcome is "rejected" or "failed" or "denied"
                                    ? "badge-danger"
                                    : "badge-warning";
                            <tr>
                                <td>#@entry.Sequence</td>
                                <td class="mono">@entry.TimestampUtc.ToString("u")</td>
                                <td><code>@entry.ActorId</code></td>
                                <td><code>@entry.Action</code></td>
                                <td><code>@entry.Target</code></td>
                                <td><span class="badge @badge">@entry.Outcome</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>

@addTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.LinkTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@model Nergal.Web.FleetDashboardViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Nergal.Web.UiStrings> L
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["LocalizedContent"] = true;
    ViewData["Title"] = "Overview";
    ViewData["ActiveNav"] = "fleet";
    ViewData["ActorRole"] = Model.ActorRole;
    ViewData["ShowManageNav"] = true;
    var next = Model.NextAction;
    var actionUrl = next.Destination switch
    {
        Nergal.Web.DashboardDestination.Hosts => Url.Action("Hosts"),
        Nergal.Web.DashboardDestination.Apply => Url.Action("Apply", new { hostId = next.HostId }),
        Nergal.Web.DashboardDestination.Audit => Url.Action("Audit"),
        _ => Url.Action("Policies"),
    };
    var attention = Model.HostHealth.Count(h => h.StateLabel is "drift" or "missing" or "pending");
}
@section Scripts {
    <link rel="stylesheet" href="@Url.Content("~/css/overview-observations.css")" asp-append-version="true" />
}
<main class="container" id="main-content" tabindex="-1">
    <div class="page-header"><div><p class="eyebrow">@Model.Settings.Branding.InstanceSubtitle</p><h1 lang="@Nergal.Web.UiLocalization.MessageLanguage(L["Overview"])" dir="auto">@L["Overview"]</h1>
        <p class="page-subtitle">@L["Firewall configuration, connected hosts and recent activity."]</p></div><span class="badge badge-neutral">@L["Native nftables"]</span></div>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    { <p class="alert alert-danger" role="alert">@Model.ErrorMessage</p> }
    <section class="card next-action" aria-labelledby="next-action-heading">
        <div><p class="eyebrow">@L[attention > 0 ? "Needs attention" : "Next action"]</p><h2 id="next-action-heading">@L[next.Heading]</h2><p>@L[next.Description]</p>
            <div class="btn-group"><a class="btn" href="@actionUrl">@L[next.Label]</a>
            @if (Model.CanMutate && Model.LatestRevision is null)
            { <a class="btn btn-secondary" href="@Url.Action("Sources")" lang="@Nergal.Web.UiLocalization.MessageLanguage(L["Import nftables.conf"])" dir="auto">@L["Import nftables.conf"]</a> }
            </div>
        </div>
        <ol class="configuration-steps" aria-label="@L["Configuration workflow"]">
            <li><span class="step-number">1</span><div><strong>@L["Prepare a policy"]</strong><span>@(Model.LatestRevision is null ? L["Create rules or import a configuration"] : L["Revision {0} saved", Model.LatestRevision.Revision])</span></div></li>
            <li><span class="step-number">2</span><div><strong>@L["Connect a host"]</strong><span>@(Model.Hosts.Count == 0 ? L["Register an enrolled agent"] : L["Registered connections: {0:N0}", Model.Hosts.Count])</span></div></li>
            <li><span class="step-number">3</span><div><strong>@L["Review and apply"]</strong><span>@L["Inspect changes, apply, then confirm"]</span></div></li>
        </ol>
    </section>
    <div class="overview-grid">
        <section class="card" aria-labelledby="configuration-heading"><div class="card-header"><h2 id="configuration-heading">@L["Saved configuration"]</h2><a href="@Url.Action("Policies")">@L["Open rules"]</a></div>
            @if (Model.LatestRevision is { } latest)
            {
                <p class="overview-number">@L["Revision {0}", latest.Revision]</p><p>@(latest.Summary ?? L["Saved policy revision"].Value)</p>
                <p class="hint">@L["Saved"] @await Html.PartialAsync("_LocalTime", latest.CreatedAtUtc). @L["Desired configuration may differ from the policy confirmed on each host."]</p>
            }
            else { <p>@L["No saved policy yet."]</p><p class="hint">@L["Use Firewall / Rules to create a policy, or Configuration / Import to start with a native file."]</p> }
            <details class="disclosure"><summary>@L["How configuration changes reach a host"]</summary><p>@L["Rule edits change the draft. Saving creates an immutable revision. Review and apply sends an explicitly selected revision to an enrolled host; its local watchdog restores the previous policy if confirmation is missing."]</p></details>
        </section>
        <section class="card" aria-labelledby="connections-heading"><div class="card-header"><h2 id="connections-heading">@L["Host status"]</h2><a href="@Url.Action("Hosts")">@L["Manage hosts"]</a></div>
            @if (Model.Hosts.Count == 0) { <p>@L["No hosts connected."]</p><p class="hint">@L["You can prepare a policy first. Agent enrollment and connection registration establish the host's trust boundary."]</p> }
            else
            {
                @await Html.PartialAsync("_DashboardHostObservations", Model)
                <ul class="host-status-list">
                @foreach (var health in Model.HostHealth.Take(5))
                {
                    <li>
                        <div>
                            <a href="@Url.Action("Apply", new { hostId = health.Host.Id })">@health.Host.Name</a>
                            @if (health.CurrentObservation is { } current)
                            {
                                <div class="hint">@L["Observed"] @await Html.PartialAsync("_LocalTime", current.ObservedAtUtc)</div>
                            }
                            else if (health.PreviousObservation is { } previous)
                            {
                                <div class="hint">
                                    @L["Previous observation ({0})", L[Nergal.Web.HostHealthSummary.ObservationLabel(previous.State)]]
                                    @if (previous.ReportedRevision is { } revision)
                                    {
                                        <span> · @L["Reported revision {0}", revision]</span>
                                    }
                                    <span> · @await Html.PartialAsync("_LocalTime", previous.ObservedAtUtc)</span>
                                </div>
                            }
                        </div>
                        <div><span class="badge badge-neutral">@L[health.StateLabel]</span></div>
                    </li>
                }
                </ul>
                @if (Model.Hosts.Count > 5) { <p class="hint">@L["Showing 5 hosts. Open Hosts for all connections."]</p> }
            }
        </section>
    </div>
    <section class="card"><div class="card-header"><h2>@L["Recent activity"]</h2><a href="@Url.Action("Audit")">@L["Open audit log"]</a></div>
        @if (Model.RecentAudit.Count == 0) { <p class="muted">@L["No configuration activity recorded yet."]</p> }
        else
        {
            <div class="table-wrap"><table><caption class="visually-hidden">@L["Latest five attributed events"]</caption><thead><tr><th>@L["Time (local)"]</th><th>@L["Action"]</th><th>@L["Outcome"]</th></tr></thead><tbody>
            @foreach (var entry in Model.RecentAudit.Take(5))
            { <tr><td>@await Html.PartialAsync("_LocalTime", entry.TimestampUtc)</td><td><code>@entry.Action</code></td><td>@entry.Outcome</td></tr> }
            </tbody></table></div>
        }
    </section>
</main>

@model Nergal.Web.PolicyEditorViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Nergal.Web.UiStrings> L
@using Nergal.Core.Policy
@{
    var states = Model.Bundle is null ? [] : PolicyRuleStates.Enumerate(Model.Bundle).Where(s => s.Scope is PolicyRuleScope.Raw or PolicyRuleScope.RawOutput or PolicyRuleScope.AuxiliaryRaw or PolicyRuleScope.Mss or PolicyRuleScope.Auxiliary or PolicyRuleScope.BridgeChain).ToArray();
}
@if (states.Length > 0)
{
    <section class="card" aria-labelledby="advanced-state-heading"><h2 id="advanced-state-heading">@L["Raw, auxiliary and sub-chain rule states"]</h2>
        <p class="hint">@L["Each switch changes only this draft. Disabled rules retain their settings and position. Review intent/native diffs, save a revision and use confirmed apply. Disabling a drop, return exemption or clamp can broaden traffic or change connectivity."]</p>
        <div class="table-wrap"><table><thead><tr><th scope="col">@L["Rule"]</th><th scope="col">@L["State"]</th></tr></thead><tbody>
            @foreach (var state in states)
            {
                var label = state.Scope switch
                {
                    PolicyRuleScope.Raw => L["Raw prerouting rule {0}", state.Index + 1].Value,
                    PolicyRuleScope.RawOutput => L["Raw output rule {0}", state.Index + 1].Value,
                    PolicyRuleScope.AuxiliaryRaw => L["Auxiliary raw {0} rule {1}", state.Chain ?? "", state.Index + 1].Value,
                    PolicyRuleScope.Mss => L["Forward SYN MSS clamp"].Value,
                    PolicyRuleScope.Auxiliary => L["Early inet filter rule {0}", state.Index + 1].Value,
                    PolicyRuleScope.BridgeChain => L["Bridge {0} rule {1}", state.Chain ?? "", state.Index + 1].Value,
                    _ => state.Label,
                };
                <tr><td>@label</td><td>@await Html.PartialAsync("_RuleStateControl", new Nergal.Web.RuleStateControlModel(Model, state with { Label = label }))</td></tr>
            }
        </tbody></table></div>
    </section>
}

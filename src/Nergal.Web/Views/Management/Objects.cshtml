@using Nergal.Core.Controller
@using Nergal.Web
@model Nergal.Web.ObjectLibraryPageModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Nergal.Web.UiStrings> L
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["LocalizedContent"] = true;
    ViewData["Title"] = "Sets & IP lists";
    ViewData["ActiveNav"] = "objects";
    ViewData["ShowManageNav"] = true;
    var selected = Model.Selected;
    var input = Model.Input ?? new ObjectLibraryInput(selected?.Id, selected?.Version ?? 0, selected?.Content.Name ?? "", selected?.Content.Kind switch { ReusableObjectKind.Ipv6 => "ipv6", ReusableObjectKind.Port => "port", _ => "ipv4" }, selected?.Content.Description ?? "", selected is null ? "" : string.Join("\n", selected.Content.Entries));
    var historical = selected is not null && Model.History.FirstOrDefault()?.Version != selected.Version;
}
<main id="main-content" tabindex="-1" class="container">
    <div class="page-header"><div><h1>@L["Sets & IP lists"]</h1><p class="page-subtitle">@L["Keep typed lists in one place, with a permanent history of every saved version."]</p></div>
        <a class="btn btn-secondary" href="@Url.Action("Objects")">@L["New list"]</a></div>
    <p class="alert alert-info">@L["Policies can pin a list version for source, destination or destination-port matching. Saving a new list version does not change existing policy revisions or firewalls. Update the reference in a policy draft, review, save and use confirmed apply."]</p>
    @if (Model.Error is not null) { <p class="alert alert-danger" role="alert" id="object-error">@Model.Error</p> }
    <section class="card" aria-labelledby="library-heading">
        <h2 id="library-heading">@L["Library"]</h2>
        <form method="get" action="@Url.Action("Objects")"><div class="field"><label for="object-search">@L["Find a list"]</label>
            <input type="text" id="object-search" name="q" value="@Model.Query" maxlength="120" aria-describedby="search-hint" />
            <span class="hint" id="search-hint">@L["Search names and descriptions. Clear the search to see every list."]</span></div>
            <button class="btn btn-secondary mt-2" type="submit">@L["Search"]</button></form>
        @if (Model.Objects.Count == 0) { <p class="empty-state">@L["No matching lists. Create a list below or change your search."]</p> }
        else
        { <div class="table-wrap mt-2"><table><caption>@L["Current library versions · stored, not applied"]</caption>
            <thead><tr><th scope="col">@L["Name"]</th><th scope="col">@L["Type"]</th><th scope="col">@L["Entries"]</th><th scope="col">@L["Version"]</th><th scope="col">@L["Saved (local time)"]</th></tr></thead>
            <tbody>@foreach (var item in Model.Objects)
            { <tr><td><a href="@Url.Action("Objects", new { objectId = item.Id })">@item.Content.Name</a><div class="muted">@item.Content.Description</div></td><td>@(item.Content.Kind switch { ReusableObjectKind.Ipv4 => "IPv4", ReusableObjectKind.Ipv6 => "IPv6", _ => L["Ports"].Value })</td><td>@item.Content.Entries.Count</td><td>@item.Version</td><td>@await Html.PartialAsync("_LocalTime", item.UpdatedAtUtc)</td></tr> }</tbody>
        </table></div> }
    </section>
    @if (selected is not null)
    {
        <section class="card mt-2" aria-labelledby="history-heading"><h2 id="history-heading">@L["{0} · version {1}", selected.Content.Name, selected.Version]</h2>
            <p>@selected.Content.Description</p>
            <h3>@L["Saved revision references ({0})", Model.Usage?.Count ?? 0]</h3>
            <p class="hint">@L["These are saved policy references, not a claim of active host usage. Every revision retains its selected version. Saving a list edit does not update any reference."]</p>
            @if (Model.Usage is not { Count: > 0 }) { <p class="muted">@L["No saved revisions reference this list."]</p> }
            else { <ul>@foreach (var use in Model.Usage) { <li><a href="@Url.Action("Policies", new { revision = use.Revision })">@L["Policy revision {0}", use.Revision]</a> · @L["list version {0}", use.ObjectVersion] · <code>@use.Path</code></li> }</ul> }

            <ul>@foreach (var entry in selected.Content.Entries) { <li><code>@entry</code></li> }</ul>
            <details class="disclosure mt-2"><summary>@L["Technical identifiers"]</summary><p class="muted">@L["Object"] <code>@selected.Id</code>. @L["Content SHA-256"] <code>@selected.Digest</code>.</p></details>
            <details class="disclosure"><summary>@L["Version history ({0})", Model.History.Count]</summary>
                <p class="hint">@L["Every version is immutable. Selecting an older version is read-only and never restores or applies it."]</p>
                <ul>@foreach (var item in Model.History) { <li><a href="@Url.Action("Objects", new { objectId = item.Id, version = item.Version })">@L["Version {0}", item.Version]</a> · @await Html.PartialAsync("_LocalTime", item.UpdatedAtUtc) · @L["{0} entries", item.Content.Entries.Count]</li> }</ul>
            </details>
        </section>
    }
    @await Html.PartialAsync("_ObjectVersionComparison", Model)
    @if (Model.CanMutate && !historical)
    {
        <section class="card mt-2" aria-labelledby="edit-object-heading"><h2 id="edit-object-heading">@(input.Id.HasValue ? L["Save a new list version"] : L["Create a list"])</h2>
            <form method="post" action="@Url.Action("SaveObject")" aria-describedby="object-save-hint @(Model.Error is null ? "" : "object-error")">
                @Html.AntiForgeryToken()
                @if (input.Id.HasValue) { <input type="hidden" name="id" value="@input.Id" /> }
                <input type="hidden" name="expectedVersion" value="@input.ExpectedVersion" />
                <div class="form-grid object-form-grid">
                    <div class="field"><label for="object-name">@L["List name"]</label>
                        <input type="text" id="object-name" name="name" value="@input.Name" maxlength="64" required readonly="@(input.Id.HasValue)" aria-describedby="object-name-hint" />
                        <span class="hint" id="object-name-hint">@L["1–64 lowercase letters, digits or underscores; start with a letter. For example, trusted_clients. Names are unique and remain fixed."]</span></div>
                    <div class="field"><label for="object-kind">@L["Entry type"]</label>
                        @if (input.Id.HasValue) { <input type="hidden" name="kind" value="@input.Kind" /><input type="text" id="object-kind" value="@input.Kind" readonly aria-describedby="object-kind-hint" /> }
                        else { <select id="object-kind" name="kind" aria-describedby="object-kind-hint"><option value="ipv4" selected="@(input.Kind == "ipv4")">@L["IPv4 addresses / CIDRs"]</option><option value="ipv6" selected="@(input.Kind == "ipv6")">@L["IPv6 addresses / CIDRs"]</option><option value="port" selected="@(input.Kind == "port")">@L["Transport ports"]</option></select> }
                        <span class="hint" id="object-kind-hint">@L["Choose one type per list. Separate IPv4 and IPv6. Port lists contain numbers; the policy rule chooses TCP or UDP."]</span></div>
                    <div class="field"><label for="object-description">@L["Description (optional)"]</label><textarea id="object-description" name="description" maxlength="500" rows="3" aria-describedby="object-description-hint">@input.Description</textarea>
                        <span class="hint" id="object-description-hint">@L["Up to 500 characters explaining the purpose and who maintains this list."]</span></div>
                    <div class="field"><label for="object-entries">@L["Entries"]</label><textarea id="object-entries" name="entries" maxlength="8192" rows="7" required aria-describedby="object-entries-hint">@input.Entries</textarea>
                        <span class="hint" id="object-entries-hint">@L["1–64 entries, one per line. Examples: 192.0.2.10, 198.51.100.0/24; for IPv6, 2001:db8::/64; for ports, 443. Use zero host bits in CIDRs. No hostnames, ranges, duplicates, dynamic flags or timeouts. Blank lines are ignored."]</span></div>
                </div>
                <p class="hint" id="object-save-hint">@L["Save retains an immutable version and audit entry. Addresses are stored as canonical CIDRs. Overlapping prefixes are retained without merging. Existing versions are unchanged."]</p>
                <button type="submit" class="btn">@(input.Id.HasValue ? L["Save new version"] : L["Create list"])</button>
            </form>
        </section>
    }
    else if (historical) { <p class="muted mt-2">@L["Viewing historical contents."] <a href="@Url.Action("Objects", new { objectId = selected!.Id })">@L["Open the current version to edit"]</a>.</p> }
    else { <p class="muted mt-2">@L["Auditor access is read-only. An Administrator can create and edit lists."]</p> }
</main>

@model Nergal.Web.NativeConversionPage
@inject Microsoft.Extensions.Localization.IStringLocalizer<Nergal.Web.UiStrings> L
@{
    var form = Model.Form;
    var selected = Model.Selected;
}
<section aria-labelledby="conversion-heading">
    <h3 id="conversion-heading">@L["Convert to a managed policy"]</h3>
    <p>@L["Map every source table and resolve uploaded includes, then review a saved conversion plan. Unsupported content blocks the whole candidate. Nothing here applies firewall rules."]</p>
    @if (Model.Error is not null) { <p class="alert alert-danger" role="alert">@L[Model.Error]</p> }
    <form method="post" action="@Url.Action("ReviewNativeConversion")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Conversion.SourceId" value="@form.SourceId" />
        <fieldset><legend>@L["1. Choose each table's destination role"]</legend>
            <p class="hint">@L["Source names do not grant ownership. Primary filtering uses priority 0; auxiliary filtering preserves an independent priority; NAT supports prerouting/postrouting; bridge supports forward and regular subchains. Unmapped or incompatible tables block conversion."]</p>
            @if (form.Tables.Count == 0) { <p>@L["No table headers found in the selected files. Resolve includes and refresh choices first."]</p> }
            @for (var i = 0; i < form.Tables.Count; i++)
            {
                var table = form.Tables[i];
                <div class="field">
                    <input type="hidden" name="Conversion.Tables[@i].Family" value="@table.Family" /><input type="hidden" name="Conversion.Tables[@i].Name" value="@table.Name" />
                    <label for="conversion-role-@i">@table.Family @table.Name</label>
                    <select id="conversion-role-@i" name="Conversion.Tables[@i].Role">
                        <option value="">@L["Choose a role"]</option>
                        @foreach (var role in new[] { ("Filter", "Primary inet filter"), ("Nat", "Inet NAT"), ("Auxiliary", "Auxiliary inet filter"), ("Bridge", "Bridge filter") })
                        { <option value="@role.Item1" selected="@(table.Role == role.Item1)">@L[role.Item2]</option> }
                    </select>
                </div>
            }
        </fieldset>
        @if (form.Includes.Count > 0)
        {
            <fieldset><legend>@L["2. Bind includes to uploaded snapshots"]</legend>
                <p class="hint">@L["Include paths are labels only; the server never opens them. Select uploaded snapshots in expansion order, top to bottom. Use the move buttons to reorder files, then refresh to discover nested includes or table headers."]</p>
                @for (var i = 0; i < form.Includes.Count; i++)
                {
                    var include = form.Includes[i];
                    var includingSourceId = include.SourceId == Guid.Empty ? form.SourceId : include.SourceId;
                    var includingSourceName = Model.AvailableSources.FirstOrDefault(s => s.Id == includingSourceId)?.Name
                        ?? L["Source"].Value.ToLowerInvariant();
                    var selectedIds = include.Sources.Where(id => id != Guid.Empty).ToArray();
                    <div class="field native-include-order" data-include-path="@include.Path" data-include-label="@L["{0} file {1}"]">
                        <input type="hidden" name="Conversion.Includes[@i].SourceId" value="@include.SourceId" />
                        <input type="hidden" name="Conversion.Includes[@i].Path" value="@include.Path" />
                        <p><strong>@include.Path</strong> @L["in {0}", includingSourceName]</p>
                        <div class="native-include-rows">
                        @for (var j = 0; j <= selectedIds.Length; j++)
                        {
                            var chosen = j < selectedIds.Length ? selectedIds[j] : Guid.Empty;
                            <div class="native-include-row mt-2">
                                <select aria-label="@L["{0} file {1}", include.Path, j + 1]" name="Conversion.Includes[@i].Sources">
                                    <option value="@Guid.Empty">@L["No additional file"]</option>
                                    @foreach (var source in Model.AvailableSources.Where(s => s.Id != form.SourceId))
                                    { <option value="@source.Id" selected="@(source.Id == chosen)">@source.Name · @source.Id.ToString("D")[..8]</option> }
                                </select>
                                <button type="button" class="btn btn-secondary" data-include-move="up">@L["Move file up"]</button>
                                <button type="button" class="btn btn-secondary" data-include-move="down">@L["Move file down"]</button>
                            </div>
                        }
                        </div>
                        <button type="button" class="btn btn-secondary mt-2" data-include-add>@L["Add another file"]</button>
                        @if (include.Path.IndexOfAny(['*', '?', '[']) >= 0)
                        {
                            <label><input type="checkbox" name="Conversion.Includes[@i].EmptyWildcard" value="true" checked="@include.EmptyWildcard" /> @L["This wildcard intentionally expands to no files."]</label>
                        }
                    </div>
                }
            </fieldset>
        }
        <details class="disclosure mt-2"><summary>@L["Source-wide operations and ownership scope"]</summary>
            <label><input type="checkbox" name="Conversion.RestrictGlobalOperations" value="true" checked="@form.RestrictGlobalOperations" /> @L["Restrict source cleanup to the selected managed resources."]</label>
            <p class="hint">@L["The original remains intact. A global flush is never executed; foreign tables are preserved. This decision is recorded in the plan. Unsupported commands and rules cannot be approved away."]</p>
        </details>
        <div class="mt-2"><button type="submit" name="operation" value="refresh" class="btn btn-secondary">@L["Refresh include and table choices"]</button> <button type="submit" name="operation" value="review" class="btn">@L["Save conversion plan for review"]</button></div>
    </form>
    @if (selected is not null)
    {
        <section class="mt-2" aria-labelledby="conversion-result-heading">
            <h3 id="conversion-result-heading">@L["Saved conversion review"]</h3>
            <p>@L["Created"] @await Html.PartialAsync("_LocalTime", selected.CreatedAtUtc). @L["This plan uses immutable database originals."]</p>
            @if (selected.Revision is { } revision)
            { <p class="alert alert-success">@L["Revision {0} was created from this plan.", revision] <a href="@Url.Action("Policies", new { revision })">@L["Open revision review"]</a>. @L["No firewall apply was requested."]</p> }
            else if (selected.Content.IsReady)
            {
                <p class="alert alert-success">@L["Ready to create a saved revision. Every source statement is accounted for in the supported grammar. Review the mappings and candidate below; confirmed apply remains a separate workflow."]</p>
                <form method="post" action="@Url.Action("CommitNativeConversion")">
                    @Html.AntiForgeryToken()<input type="hidden" name="planId" value="@selected.Id" /><input type="hidden" name="digest" value="@selected.Content.Digest" />
                    <p class="hint">@L["Creates one immutable revision and its pinned reusable lists atomically. Future list edits cannot change this revision."]</p>
                    <button type="submit" class="btn">@L["Create reviewed policy revision"]</button>
                </form>
            }
            else
            { <p class="alert alert-warning">@L["Conversion blocked: {0} gaps. No partial policy or reusable list was created. Resolve the source or choices and review a new plan.", selected.Content.GapCount]</p> }
            @if (Model.Gaps.Count > 0)
            {
                <div class="table-wrap"><table><caption>@L["Blocking conversion gaps"]</caption><thead><tr><th>@L["Source"]</th><th>@L["Position"]</th><th>@L["Reason"]</th></tr></thead><tbody>
                @foreach (var gap in Model.Gaps.Take(100))
                { <tr><td><a href="@Url.Action("Sources", new { sourceId = gap.SourceId })">@(Model.AvailableSources.FirstOrDefault(s => s.Id == gap.SourceId)?.Name ?? L["Source"].Value)</a></td><td>@L["Line {0}, column {1}", gap.Span.Line, gap.Span.Column]</td><td><code>@gap.Code</code><br />@L["This statement must be represented completely; it cannot be skipped."]</td></tr> }
                </tbody></table></div>
                @if (Model.Gaps.Count > 100) { <p class="hint">@L["Showing the first 100 gaps. Download the report for all {0} gaps.", Model.Gaps.Count]</p> }
            }
            <details class="disclosure mt-2"><summary>@L["Source-to-policy mappings ({0})", Model.Mappings.Count]</summary>
                <div class="table-wrap"><table><thead><tr><th>@L["Source"]</th><th>@L["Source position"]</th><th>@L["Disposition"]</th><th>@L["Destination"]</th></tr></thead><tbody>
                @foreach (var mapping in Model.Mappings.Take(200))
                { <tr><td><a href="@Url.Action("Sources", new { sourceId = mapping.SourceId })">@(Model.AvailableSources.FirstOrDefault(s => s.Id == mapping.SourceId)?.Name ?? L["Source"].Value)</a></td><td>@L["Line {0}, column {1}", mapping.Span.Line, mapping.Span.Column]</td><td>@mapping.Disposition</td><td><code>@mapping.Target</code></td></tr> }
                </tbody></table></div>
                @if (Model.Mappings.Count > 200) { <p class="hint">@L["Showing the first 200 mappings. Download the report for all {0} mappings.", Model.Mappings.Count]</p> }
            </details>
            @if (Model.Candidate is not null)
            { <details class="disclosure mt-2"><summary>@L["Complete generated candidate"]</summary><pre><code>@Model.Candidate</code></pre></details> }
            <a class="btn btn-secondary mt-2" href="@Url.Action("DownloadNativeConversionPlan", new { planId = selected.Id })">@L["Download mapping and gap report"]</a>
        </section>
    }
    @if (Model.History.Count > 0)
    {
        <details class="disclosure mt-2"><summary>@L["Conversion plan history ({0})", Model.History.Count]</summary><ul>
            @foreach (var plan in Model.History)
            { <li><a href="@Url.Action("Sources", new { sourceId = form.SourceId, planId = plan.Id })">@plan.Id.ToString("D")[..8]</a> · @await Html.PartialAsync("_LocalTime", plan.CreatedAtUtc) · @(plan.Revision.HasValue ? L["Revision created"] : plan.Content.IsReady ? L["Ready for revision"] : L["Blocked: {0} gaps", plan.Content.GapCount])</li> }
        </ul></details>
    }
</section>
<script src="~/js/native-includes.js" asp-append-version="true" defer></script>

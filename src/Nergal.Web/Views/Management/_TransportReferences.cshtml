@model Nergal.Web.TransportReferenceFormModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Nergal.Web.UiStrings> L
@{
    var postrouting = Model.Scope is "dnat" or "postrouting";
    var dnat = Model.Scope == "dnat";
    var retained = Model.Editor.ObjectBrowseSelection is { } browse && browse.Scope == Model.Scope && browse.Chain == Model.Chain ? browse : null;
    var prefix = "reference-" + Model.Scope + "-" + (Model.Chain ?? "base");
    var label = Model.Scope switch
    {
        "dnat" => L["DNAT list references"],
        "postrouting" => L["Postrouting NAT list references"],
        _ => L["Bridge {0} list references", Model.Chain ?? "forward"],
    };
}
@if (Model.Editor.CanMutate && Model.Rules.Count > 0)
{
    <h3 id="@(prefix)-heading">@label</h3>
    @if (Model.Editor.ObjectBrowseSelection is { } history && Model.Editor.LibraryObjects.Any(o => o.Id == history.ObjectId))
    { <p class="hint">@L["Saved versions loaded for {0}; browsing left this draft unchanged.", Model.Editor.LibraryObjects.First(o => o.Id == history.ObjectId).Content.Name]</p> }
    <form method="post" action="@Url.Content("~/manage/policies/objects")" aria-describedby="@(prefix)-hint">
        @Html.AntiForgeryToken()
        <input type="hidden" name="bundleJson" value="@Model.Editor.BundleJson" /><input type="hidden" name="summary" value="@Model.Editor.Summary" /><input type="hidden" name="compareToRevision" value="@Model.Editor.CompareToRevision" /><input type="hidden" name="scope" value="@Model.Scope" />
        @if (Model.Chain is not null) { <input type="hidden" name="chain" value="@Model.Chain" /> }
        <div class="form-grid">
            <div class="field"><label for="@(prefix)-rule">@(dnat ? L["DNAT rule"] : postrouting ? L["Postrouting rule"] : L["Bridge rule"])</label><select id="@(prefix)-rule" name="ruleIndex">@foreach (var rule in Model.Rules) { <option value="@rule.Index" selected="@(retained?.RuleIndex == rule.Index)">@rule.Label</option> }</select></div>
            <div class="field"><label for="@(prefix)-slot">@L["Matcher to change"]</label><select id="@(prefix)-slot" name="slot"><option value="ports" selected="@(retained is null || retained.Slot == "ports")">@(dnat ? L["Original destination ports"] : L["Destination ports"])</option><option value="source" selected="@(retained?.Slot == "source")">@L["Source address"]</option><option value="destination" selected="@(retained?.Slot == "destination")">@(dnat ? L["Original destination address"] : L["Destination address"])</option></select></div>
            <div class="field"><label for="@(prefix)-selection">@L["List version"]</label><select id="@(prefix)-selection" name="selection"><option value="">@L["Choose a list for attachment"]</option>@foreach (var item in Model.Editor.LibraryObjects) { <option value="@item.Id/@item.Version" selected="@(retained?.ObjectId == item.Id && retained.Version == item.Version)">@item.Content.Name · v@(item.Version) · @string.Join(", ", item.Content.Entries)</option> }</select></div>
        </div>
        @if (dnat)
        { <p id="@(prefix)-hint" class="hint">@L["Choose a matching-family address list or a Port list, and optionally browse its immutable history. Attachment replaces only the selected matcher before translation; all matches use the same explicit target. Ports require TCP or UDP. Removal clears the selected source or port restriction (and source negation), which may broaden matching. Original destination is required, so removing its sole reference is denied; replace it explicitly instead. Other matchers, translation, order and enabled state remain. Review the draft, save a revision, then use confirmed apply."]</p> }
        else
        { <p id="@(prefix)-hint" class="hint">@L["Browse a selected list to show older versions. Only one history is loaded at a time. Attachment pins the displayed version, replacing literals or the prior reference. Address lists must match the NAT family; ports require TCP or UDP. Bridge address lists require an explicit IP family. Removal clears the selected restriction (and NAT address negation), which may broaden matching; explicit SNAT still requires a source restriction. Other matchers, action, enabled state and order remain. Review the draft, save a revision, then use confirmed apply."]</p> }
        <div class="btn-group"><button type="submit" name="operation" value="history" class="btn btn-secondary">@L["Browse selected list history"]</button><button type="submit" name="operation" value="attach">@L["Attach list to draft"]</button><button type="submit" name="operation" value="remove" class="btn btn-secondary">@L["Remove list reference from draft"]</button></div>
    </form>
}

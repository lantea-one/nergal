@model Nergal.Web.AuxiliaryRuleFormModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Nergal.Web.UiStrings> L
@using Nergal.Core.Policy
@{
    var r = Model.Index is { } index ? Model.Editor.Bundle!.AuxiliaryFilter!.Filter.Rules[index] : null;
    var prefix = "aux-" + (Model.Index?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "new");
    var sources = r?.Source?.Value ?? (r?.SourcePrefixes is null ? "" : string.Join(", ", r.SourcePrefixes.Select(p => p.Value)));
    var destinations = r?.Destination?.Value ?? (r?.DestinationPrefixes is null ? "" : string.Join(", ", r.DestinationPrefixes.Select(p => p.Value)));
    var ports = r?.DestinationPort?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? (r?.DestinationPorts is null ? "" : string.Join(", ", r.DestinationPorts));
    var macs = r?.SourceMac?.Value ?? (r?.SourceMacs is null ? "" : string.Join(", ", r.SourceMacs.Select(m => m.Value)));
    var states = r is null || r.ConnectionStates == ConnectionStateFlags.None ? "" : r.ConnectionStates.ToString().ToLowerInvariant();
}
<form class="router-form" method="post" action="@Url.Content("~/manage/policies/auxiliary/rule")" aria-describedby="@(prefix)-hint">
    @Html.AntiForgeryToken()
    <input type="hidden" name="bundleJson" value="@Model.Editor.BundleJson" /><input type="hidden" name="summary" value="@Model.Editor.Summary" /><input type="hidden" name="compareToRevision" value="@Model.Editor.CompareToRevision" /><input type="hidden" name="operation" value="@(Model.Index is null ? "add" : "edit")" />
    @if (Model.Index is not null) { <input type="hidden" name="ruleIndex" value="@Model.Index" /> }
    <p id="@(prefix)-hint" class="hint">@L["An independent inet filter rule. Empty optional matchers mean any; clearing them may broaden access. Except requires its matcher. Edits preserve enabled state, order and existing list pins. This changes only the draft."]</p>
    <div class="form-grid">
        <div class="field"><label for="@(prefix)-chain">@L["Chain"]</label><select id="@(prefix)-chain" name="chain"><option value="input" selected="@(r is null || r.Chain == FilterChainKind.Input)">@L["Input"]</option><option value="forward" selected="@(r?.Chain == FilterChainKind.Forward)">@L["Forward"]</option><option value="output" selected="@(r?.Chain == FilterChainKind.Output)">@L["Output"]</option></select></div>
        <div class="field">
            <label for="@(prefix)-family">@L["IP family"]</label>
            <select id="@(prefix)-family" name="family">
                <option value="ipv4" selected="@(r is null || r.Family == IpFamily.IPv4)">IPv4</option>
                <option value="ipv6" selected="@(r?.Family == IpFamily.IPv6)">IPv6</option>
                @if (r?.CountPackets == true)
                {
                    <option value="dualStack" selected="@(r.Family == IpFamily.DualStack)">@L["IPv4 and IPv6"]</option>
                }
            </select>
        </div>
        <div class="field"><label for="@(prefix)-protocol">@L["Protocol"]</label><select id="@(prefix)-protocol" name="protocol"><option value="any" selected="@(r is null || r.Protocol == FilterProtocol.Any)">@L["Any"]</option><option value="tcp" selected="@(r?.Protocol == FilterProtocol.Tcp)">TCP</option><option value="udp" selected="@(r?.Protocol == FilterProtocol.Udp)">UDP</option><option value="icmp" selected="@(r?.Protocol == FilterProtocol.Icmp)">@L["ICMP (IPv4)"]</option><option value="icmpv6" selected="@(r?.Protocol == FilterProtocol.IcmpV6)">ICMPv6</option></select></div>
        <div class="field">
            <label for="@(prefix)-verdict">@L["Verdict"]</label>
            <select id="@(prefix)-verdict" name="verdict">
                <option value="accept" selected="@(r?.Verdict == FilterVerdict.Accept)">@L["Accept"]</option>
                <option value="drop" selected="@(r is null || r.Verdict == FilterVerdict.Drop)">@L["Drop"]</option>
                <option value="reject" selected="@(r?.Verdict == FilterVerdict.Reject)">@L["Reject — ICMP admin prohibited"]</option>
                <option value="rejectPortUnreachable" selected="@(r?.Verdict == FilterVerdict.RejectPortUnreachable)">@L["Reject — ICMP port unreachable"]</option>
                @if (r?.CountPackets == true)
                {
                    <option value="continue" selected="@(r.Verdict == FilterVerdict.Continue)">@L["Count and continue"]</option>
                }
            </select>
        </div>
        <div class="field"><label for="@(prefix)-sources">@L["Source CIDR(s) (optional)"]</label><input type="text" id="@(prefix)-sources" name="sources" value="@sources" readonly="@(r?.SourceObject is not null)" aria-describedby="@(prefix)-sources-hint" /><span id="@(prefix)-sources-hint" class="hint">@L["One CIDR or a comma-separated list of disjoint networks."]</span></div>
        <div class="field"><label for="@(prefix)-destinations">@L["Destination CIDR(s) (optional)"]</label><input type="text" id="@(prefix)-destinations" name="destinations" value="@destinations" readonly="@(r?.DestinationObject is not null)" aria-describedby="@(prefix)-destinations-hint" /><span id="@(prefix)-destinations-hint" class="hint">@L["Use the selected IP family."]</span></div>
        <div class="field"><label for="@(prefix)-destinationPorts">@L["Destination port(s) (optional)"]</label><input type="text" id="@(prefix)-destinationPorts" name="destinationPorts" value="@ports" readonly="@(r?.DestinationPortObject is not null)" aria-describedby="@(prefix)-destinationPorts-hint" /><span id="@(prefix)-destinationPorts-hint" class="hint">@L["One port or comma-separated ports, 1–65535; requires TCP or UDP."]</span></div>
        <div class="field"><label for="@(prefix)-icmpType">@L["ICMP type (optional)"]</label><input type="text" id="@(prefix)-icmpType" name="icmpType" value="@r?.IcmpType"  aria-describedby="@(prefix)-icmpType-hint" /><span id="@(prefix)-icmpType-hint" class="hint">@L["For example echo-request; requires the matching ICMP family."]</span></div>
        <div class="field"><label for="@(prefix)-inputInterface">@L["Input interface (optional)"]</label><input type="text" id="@(prefix)-inputInterface" name="inputInterface" value="@r?.InputInterface" maxlength="15" aria-describedby="@(prefix)-inputInterface-hint" /><span id="@(prefix)-inputInterface-hint" class="hint">@L["Valid for Input or Forward chains."]</span></div>
        <div class="field"><label for="@(prefix)-outputInterface">@L["Output interface (optional)"]</label><input type="text" id="@(prefix)-outputInterface" name="outputInterface" value="@r?.OutputInterface" maxlength="15" aria-describedby="@(prefix)-outputInterface-hint" /><span id="@(prefix)-outputInterface-hint" class="hint">@L["Valid for Output or Forward chains."]</span></div>
        <div class="field"><label for="@(prefix)-connectionStates">@L["Connection states (optional)"]</label><input type="text" id="@(prefix)-connectionStates" name="connectionStates" value="@states"  aria-describedby="@(prefix)-connectionStates-hint" /><span id="@(prefix)-connectionStates-hint" class="hint">@L["Comma-separated: new, established, related, invalid."]</span></div>
        <div class="field"><label for="@(prefix)-sourceMacs">@L["Source MAC address(es) (optional)"]</label><input type="text" id="@(prefix)-sourceMacs" name="sourceMacs" value="@macs"  aria-describedby="@(prefix)-sourceMacs-hint" /><span id="@(prefix)-sourceMacs-hint" class="hint">@L["Colon-delimited MACs, comma-separated; matches the directly visible Ethernet sender."]</span></div>
        <div class="field"><label for="@(prefix)-description">@L["Description (optional)"]</label><input type="text" id="@(prefix)-description" name="description" value="@r?.Description" maxlength="160" aria-describedby="@(prefix)-description-hint" /><span id="@(prefix)-description-hint" class="hint">@L["A short operator note; no effect on matching."]</span></div>
        <label class="checkbox-row"><input type="checkbox" name="negateSource" value="true" checked="@(r?.NegateSource == true)" /> @L["Except source IP/network(s)"]</label>
        <label class="checkbox-row"><input type="checkbox" name="negateDestination" value="true" checked="@(r?.NegateDestination == true)" /> @L["Except destination IP/network(s)"]</label>
        <label class="checkbox-row"><input type="checkbox" name="negateInputInterface" value="true" checked="@(r?.NegateInputInterface == true)" /> @L["Except input interface"]</label>
        <label class="checkbox-row"><input type="checkbox" name="negateOutputInterface" value="true" checked="@(r?.NegateOutputInterface == true)" /> @L["Except output interface"]</label>
        <label class="checkbox-row"><input type="checkbox" name="negateSourceMac" value="true" checked="@(r?.NegateSourceMac == true)" /> @L["Except source MAC address(es)"]</label>
        <label class="checkbox-row"><input type="checkbox" name="matchOriginalDestinationDnat" value="true" checked="@(r?.MatchOriginalDestinationDnat == true)" /> @L["Match connection originally translated by DNAT"]</label>
    </div>
    <fieldset class="mt-2"><legend>@L["Optional rate limit"]</legend><p class="hint">@L["Enter both packets and burst to configure a bucket. Clear both to remove it. Destination buckets share a limit across callers reaching the same destination."]</p><div class="form-grid">
        <div class="field"><label for="@(prefix)-rateLimitPackets">@L["Packets per window"]</label><input type="number" id="@(prefix)-rateLimitPackets" name="rateLimitPackets" value="@(r?.RateLimit?.PacketsPerWindow)" min="1" max="1000000" /></div>
        <div class="field"><label for="@(prefix)-rateLimitBurst">@L["Burst packets"]</label><input type="number" id="@(prefix)-rateLimitBurst" name="rateLimitBurst" value="@(r?.RateLimit?.Burst)" min="1" max="10000" /></div>
        <div class="field"><label for="@(prefix)-rateLimitTimeout">@L["Entry timeout (seconds)"]</label><input type="number" id="@(prefix)-rateLimitTimeout" name="rateLimitTimeout" value="@(r?.RateLimit?.EntryTimeoutSeconds ?? 60)" min="1" max="86400" /></div>
        <div class="field"><label for="@(prefix)-unit">@L["Window"]</label><select id="@(prefix)-unit" name="rateLimitUnit"><option value="second" selected="@(r?.RateLimit?.WindowUnit != RateLimitTimeUnit.Minute)">@L["Second"]</option><option value="minute" selected="@(r?.RateLimit?.WindowUnit == RateLimitTimeUnit.Minute)">@L["Minute"]</option></select></div>
        <div class="field"><label for="@(prefix)-key">@L["Bucket key"]</label><select id="@(prefix)-key" name="rateLimitKey"><option value="sourceAddress" selected="@(r?.RateLimit?.KeyKind != RateLimitKeyKind.DestinationAddress)">@L["Per source address"]</option><option value="destinationAddress" selected="@(r?.RateLimit?.KeyKind == RateLimitKeyKind.DestinationAddress)">@L["Per destination address"]</option></select></div>
                <div class="field"><label for="@(prefix)-refresh">@L["Meter entry expiry"]</label><select id="@(prefix)-refresh" name="refreshEntryTimeout"><option value="false" selected="@(r?.RateLimit?.RefreshEntryTimeout != true)">@L["From entry creation (add)"]</option><option value="true" selected="@(r?.RateLimit?.RefreshEntryTimeout == true)">@L["Refresh on matching packets (meter/update)"]</option></select><span class="hint">@L["Preserve the imported operation. Refreshing keeps an active bucket alive; creation-based expiry can reset it while traffic continues."]</span></div>
    </div></fieldset>
    <button type="submit" class="btn btn-secondary btn-sm">@(Model.Index is null ? L["Add auxiliary rule to draft"] : L["Update auxiliary rule draft"])</button>
</form>

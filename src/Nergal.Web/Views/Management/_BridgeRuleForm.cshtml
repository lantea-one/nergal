@model Nergal.Web.BridgeRuleFormModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Nergal.Web.UiStrings> L
@using Nergal.Core.Policy
@{
    var bridge = Model.Editor.Bundle!.Bridge!;
    var rules = Model.Chain is null ? bridge.Rules : (bridge.SubChains.FirstOrDefault(c => c.Name == Model.Chain)?.Rules ?? []);
    var r = Model.Index is { } index ? rules[index] : null;
    var prefix = "bridge-" + (Model.Chain ?? "forward") + "-" + (Model.Index?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "new");
    var action = r?.JumpTarget is not null ? "jump" : r?.Return == true ? "return" : r?.Verdict == FilterVerdict.Accept ? "accept" : "drop";
    var sources = r?.Source?.Value ?? (r?.SourcePrefixes is { } sourceSet ? string.Join(", ", sourceSet.Select(p => p.Value)) : "");
    var destinations = r?.Destination?.Value ?? (r?.DestinationPrefixes is { } destinationSet ? string.Join(", ", destinationSet.Select(p => p.Value)) : "");
    var ports = r?.DestinationPort?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? (r?.DestinationPorts is null ? "" : string.Join(", ", r.DestinationPorts));
}
<form class="router-form" method="post" action="@Url.Content("~/manage/policies/bridge/rule")" aria-describedby="@(prefix)-hint">
    @Html.AntiForgeryToken()
    <input type="hidden" name="bundleJson" value="@Model.Editor.BundleJson" /><input type="hidden" name="summary" value="@Model.Editor.Summary" /><input type="hidden" name="compareToRevision" value="@Model.Editor.CompareToRevision" /><input type="hidden" name="operation" value="@(Model.Index is null ? "add" : "edit")" />
    @if (Model.Chain is not null) { <input type="hidden" name="chain" value="@Model.Chain" /> }
    @if (Model.Index is not null) { <input type="hidden" name="ruleIndex" value="@Model.Index" /> }
    <fieldset disabled="@(!Model.Editor.CanMutate)"><legend>@L["Bridge matchers and action"]</legend>
    <p id="@(prefix)-hint" class="hint">@L["Empty optional matchers mean any; removing them may broaden access. Ethernet and IP families must agree. Choose an IP family for IP-prefix matching; transport matching can cover both families. A jump calls a declared local regular chain; Return resumes its caller and is allowed only inside a regular chain. Editing preserves enabled state and order."]</p>
    @if (r?.CountPackets == true) { <p class="hint">@L["This rule counts matching frames and bytes before its action."]</p> }
    @if (r?.BindInputInterfaceIndex == true) { <p class="hint">@L["Installation binds the ingress port name to its interface index."]</p> }
    <div class="form-grid">
        <div class="field"><label for="@(prefix)-etherType">@L["Ethernet protocol"]</label><select id="@(prefix)-etherType" name="etherType"><option value="any" selected="@(r is null || r.EtherType == BridgeEtherType.Any)">@L["Any"]</option><option value="ipv4" selected="@(r?.EtherType == BridgeEtherType.IPv4)">IPv4</option><option value="ipv6" selected="@(r?.EtherType == BridgeEtherType.IPv6)">IPv6</option><option value="arp" selected="@(r?.EtherType == BridgeEtherType.Arp)">ARP</option></select></div>
        <div class="field"><label for="@(prefix)-family">@L["IP family"]</label><select id="@(prefix)-family" name="family"><option value="none" selected="@(r?.Family is null)">@L["No IP restriction"]</option><option value="ipv4" selected="@(r?.Family == IpFamily.IPv4)">IPv4</option><option value="ipv6" selected="@(r?.Family == IpFamily.IPv6)">IPv6</option></select></div>
        <div class="field"><label for="@(prefix)-protocol">@L["Transport protocol"]</label><select id="@(prefix)-protocol" name="protocol"><option value="any" selected="@(r is null || r.Protocol == FilterProtocol.Any)">@L["Any"]</option><option value="tcp" selected="@(r?.Protocol == FilterProtocol.Tcp)">TCP</option><option value="udp" selected="@(r?.Protocol == FilterProtocol.Udp)">UDP</option></select></div>
        <div class="field"><label for="@(prefix)-action">@L["Bridge action"]</label><select id="@(prefix)-action" name="action"><option value="accept" selected="@(action == "accept")">@L["Accept"]</option><option value="drop" selected="@(action == "drop")">@L["Drop"]</option><option value="jump" selected="@(action == "jump")">@L["Jump to regular chain"]</option><option value="return" selected="@(action == "return")">@L["Return to caller"]</option></select></div>
        <div class="field"><label for="@(prefix)-jump">@L["Jump target"]</label><select id="@(prefix)-jump" name="jumpTarget" aria-describedby="@(prefix)-jump-hint"><option value="">@L["No jump target"]</option>@foreach (var chain in bridge.SubChains) { <option value="@chain.Name" selected="@(r?.JumpTarget == chain.Name)">@chain.Name</option> }</select><span id="@(prefix)-jump-hint" class="hint">@L["Choose only for Jump. Create the regular chain first. Missing targets and cycles are rejected, including in disabled rules."]</span></div>
        <div class="field"><label for="@(prefix)-bridgeName">@L["Input bridge master (optional)"]</label><input type="text" id="@(prefix)-bridgeName" name="bridgeName" value="@r?.BridgeName" maxlength="15" aria-describedby="@(prefix)-bridgeName-hint" /><span id="@(prefix)-bridgeName-hint" class="hint">@L["Matches meta ibrname, for example br0."]</span></div>
        <div class="field"><label for="@(prefix)-inputInterface">@L["Input bridge port (optional)"]</label><input type="text" id="@(prefix)-inputInterface" name="inputInterface" value="@r?.InputInterface" maxlength="15" aria-describedby="@(prefix)-inputInterface-hint" /><span id="@(prefix)-inputInterface-hint" class="hint">@L["Ingress port name, for example lan0."]</span></div>
        <div class="field"><label for="@(prefix)-outputInterface">@L["Output bridge port (optional)"]</label><input type="text" id="@(prefix)-outputInterface" name="outputInterface" value="@r?.OutputInterface" maxlength="15" aria-describedby="@(prefix)-outputInterface-hint" /><span id="@(prefix)-outputInterface-hint" class="hint">@L["Egress port name, for example lan1."]</span></div>
        <div class="field"><label for="@(prefix)-sourceMac">@L["Source MAC (optional)"]</label><input type="text" id="@(prefix)-sourceMac" name="sourceMac" value="@r?.SourceMac?.Value" aria-describedby="@(prefix)-sourceMac-hint" /><span id="@(prefix)-sourceMac-hint" class="hint">@L["Colon-delimited 48-bit address, for example 02:00:00:00:00:01."]</span></div>
        <div class="field"><label for="@(prefix)-destinationMac">@L["Destination MAC (optional)"]</label><input type="text" id="@(prefix)-destinationMac" name="destinationMac" value="@r?.DestinationMac?.Value" aria-describedby="@(prefix)-destinationMac-hint" /><span id="@(prefix)-destinationMac-hint" class="hint">@L["Matches ether daddr; negation requires a MAC."]</span></div>
        <div class="field"><label for="@(prefix)-source">@L["Source CIDR(s) (optional)"]</label><input type="text" id="@(prefix)-source" name="@(r?.SourceObject is null ? "source" : null)" value="@(r?.SourceObject is { } sourcePin ? string.Join(", ", sourcePin.Content.Entries) : sources)" readonly="@(r?.SourceObject is not null)" aria-describedby="@(prefix)-source-hint" /><span id="@(prefix)-source-hint" class="hint">@L["One CIDR or 2–64 distinct, disjoint/non-adjacent CIDRs. Requires a matching IP family; pinned contents are read-only."]</span></div>
        <div class="field"><label for="@(prefix)-destination">@L["Destination CIDR(s) (optional)"]</label><input type="text" id="@(prefix)-destination" name="@(r?.DestinationObject is null ? "destination" : null)" value="@(r?.DestinationObject is { } destinationPin ? string.Join(", ", destinationPin.Content.Entries) : destinations)" readonly="@(r?.DestinationObject is not null)" aria-describedby="@(prefix)-destination-hint" /><span id="@(prefix)-destination-hint" class="hint">@L["One CIDR or 2–64 distinct, disjoint/non-adjacent CIDRs. Requires a matching IP family; pinned contents are read-only."]</span></div>
        <div class="field"><label for="@(prefix)-destinationPorts">@L["Destination port(s) (optional)"]</label><input type="text" id="@(prefix)-destinationPorts" name="@(r?.DestinationPortObject is null ? "destinationPorts" : null)" value="@(r?.DestinationPortObject is { } selectedPorts ? string.Join(", ", selectedPorts.Content.Entries) : ports)" readonly="@(r?.DestinationPortObject is not null)" aria-describedby="@(prefix)-destinationPorts-hint" /><span id="@(prefix)-destinationPorts-hint" class="hint">@L["One port or comma-separated ports, 1–65535; requires TCP or UDP."]</span></div>
        <div class="field"><label for="@(prefix)-description">@L["Description (optional)"]</label><input type="text" id="@(prefix)-description" name="description" value="@r?.Description" maxlength="160" aria-describedby="@(prefix)-description-hint" /><span id="@(prefix)-description-hint" class="hint">@L["An operator note; has no effect on matching."]</span></div>
        <label class="checkbox-row"><input type="checkbox" name="negateSourceMac" value="true" checked="@(r?.NegateSourceMac == true)" /> @L["Except source MAC"]</label>
        <label class="checkbox-row"><input type="checkbox" name="negateDestinationMac" value="true" checked="@(r?.NegateDestinationMac == true)" /> @L["Except destination MAC"]</label>
    </div>
    @if (Model.Editor.CanMutate) { <button type="submit" class="btn btn-secondary btn-sm">@(Model.Index is null ? L["Add bridge rule to draft"] : L["Update bridge rule draft"])</button> }
    </fieldset>
    @if (r?.SourceObject is { } sourceObject) { <p class="hint">@L["Pinned source list:"] <strong>@sourceObject.Content.Name v@(sourceObject.Version)</strong>.</p> }
    @if (r?.DestinationObject is { } destinationObject) { <p class="hint">@L["Pinned destination list:"] <strong>@destinationObject.Content.Name v@(destinationObject.Version)</strong>.</p> }
    @if (r?.DestinationPortObject is { } pinned) { <p class="hint">@L["Pinned port list:"] <strong>@pinned.Content.Name v@(pinned.Version)</strong> · @string.Join(", ", pinned.Content.Entries)@L[". Manage this matcher in this chain's reusable-list selector."]</p> }
</form>

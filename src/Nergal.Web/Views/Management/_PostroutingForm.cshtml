@model Nergal.Web.PostroutingFormModel
@using Nergal.Core.Policy
@{
    var s = Model.Index is { } index ? Model.Editor.Bundle!.Nat!.SnatRules[index] : null;
    var prefix = "postrouting-" + (Model.Index?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "new");
    var action = s?.Action ?? NatPostroutingAction.Snat;
    var ports = s?.DestinationPort?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? (s?.DestinationPorts is null ? "" : string.Join(", ", s.DestinationPorts));
}
<form class="router-form" method="post" action="@Url.Content("~/manage/policies/nat/postrouting")" aria-describedby="@(prefix)-hint">
    @Html.AntiForgeryToken()
    <input type="hidden" name="bundleJson" value="@Model.Editor.BundleJson" />
    <input type="hidden" name="summary" value="@Model.Editor.Summary" />
    <input type="hidden" name="compareToRevision" value="@Model.Editor.CompareToRevision" />
    @if (Model.Index is not null) { <input type="hidden" name="ruleIndex" value="@Model.Index" /> }
    <p id="@(prefix)-hint" class="hint">Rules run in order. Return stops this NAT chain without translation; place exemptions before translation rules. Empty optional matchers mean any. Negation means “anything except” and requires that matcher. Changes update the draft for review, not the live firewall.</p>
    <div class="form-grid">
        <div class="field"><label for="@(prefix)-family">IP family</label><select id="@(prefix)-family" name="family"><option value="ipv4" selected="@(s?.Family != IpFamily.IPv6)">IPv4</option><option value="ipv6" selected="@(s?.Family == IpFamily.IPv6)">IPv6</option></select></div>
        <div class="field"><label for="@(prefix)-action">Postrouting action</label><select id="@(prefix)-action" name="action"><option value="snat" selected="@(action == NatPostroutingAction.Snat)">SNAT — explicit address</option><option value="masquerade" selected="@(action == NatPostroutingAction.Masquerade)">Masquerade — output address</option><option value="return" selected="@(action == NatPostroutingAction.Return)">Return — translation exemption</option></select></div>
        <div class="field"><label for="@(prefix)-target">Translated IP address</label><input type="text" id="@(prefix)-target" name="translatedAddress" value="@s?.TranslatedAddress" aria-describedby="@(prefix)-target-hint" /><span id="@(prefix)-target-hint" class="hint">Required for explicit SNAT; leave empty for masquerade or return. Must match the selected IP family.</span></div>
        <div class="field"><label for="@(prefix)-source">Source CIDR (optional)</label><input type="text" id="@(prefix)-source" name="source" value="@s?.Source?.Value" placeholder="192.0.2.0/24" /><label class="checkbox-row"><input type="checkbox" name="negateSource" value="true" checked="@(s?.NegateSource == true)" /> Except this source</label></div>
        <div class="field"><label for="@(prefix)-destination">Destination CIDR (optional)</label><input type="text" id="@(prefix)-destination" name="destination" value="@s?.Destination?.Value" placeholder="203.0.113.0/24" /><label class="checkbox-row"><input type="checkbox" name="negateDestination" value="true" checked="@(s?.NegateDestination == true)" /> Except this destination</label></div>
        <div class="field"><label for="@(prefix)-input">Input interface (optional)</label><input type="text" id="@(prefix)-input" name="inputInterface" value="@s?.InputInterface" maxlength="15" /><label class="checkbox-row"><input type="checkbox" name="negateInputInterface" value="true" checked="@(s?.NegateInputInterface == true)" /> Except this input interface</label></div>
        <div class="field"><label for="@(prefix)-output">Output interface (optional)</label><input type="text" id="@(prefix)-output" name="outputInterface" value="@s?.OutputInterface" maxlength="15" /><label class="checkbox-row"><input type="checkbox" name="negateOutputInterface" value="true" checked="@(s?.NegateOutputInterface == true)" /> Except this output interface</label></div>
        <div class="field"><label for="@(prefix)-protocol">Protocol</label><select id="@(prefix)-protocol" name="protocol"><option value="any" selected="@(s is null || s.Protocol == FilterProtocol.Any)">Any</option><option value="tcp" selected="@(s?.Protocol == FilterProtocol.Tcp)">TCP</option><option value="udp" selected="@(s?.Protocol == FilterProtocol.Udp)">UDP</option></select></div>
        <div class="field"><label for="@(prefix)-ports">Destination port(s) (optional)</label><input type="text" id="@(prefix)-ports" name="@(s?.DestinationPortObject is null ? "destinationPorts" : null)" value="@(s?.DestinationPortObject is { } selectedPorts ? string.Join(", ", selectedPorts.Content.Entries) : ports)" readonly="@(s?.DestinationPortObject is not null)" aria-describedby="@(prefix)-ports-hint" /><span id="@(prefix)-ports-hint" class="hint">One port or comma-separated ports in 1–65535. Requires TCP or UDP.</span></div>
        <div class="field span-2"><label for="@(prefix)-description">Description (optional)</label><input type="text" id="@(prefix)-description" name="description" value="@s?.Description" maxlength="160" /></div>
    </div>
    <button type="submit" class="btn btn-sm">@(Model.Index is null ? "Add postrouting rule" : "Update postrouting draft")</button>
    @if (s?.DestinationPortObject is { } pinned) { <p class="hint">Pinned port list: <strong>@pinned.Content.Name v@(pinned.Version)</strong> · @string.Join(", ", pinned.Content.Entries). Manage this matcher in the postrouting port-list selector below.</p> }
</form>

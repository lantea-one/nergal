@model Nergal.Web.PolicyEditorViewModel
@addTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.ComponentTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.ScriptTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@using Nergal.Core.Policy
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Firewall";
    ViewData["ActiveNav"] = "policies";
    ViewData["ActorRole"] = Model.ActorRole;
    ViewData["ShowManageNav"] = true;
    ViewData["PolicySection"] = Model.InitialSection ?? "filter";
    var bundle = Model.Bundle;
    var filterCount = bundle?.Filter.Rules.Count ?? 0;
    var natCount = (bundle?.Nat?.DnatRules.Count ?? 0) + (bundle?.Nat?.SnatRules.Count ?? 0);
    var bridgeCount = bundle?.Bridge?.Rules.Count ?? 0;
}
<main id="main-content" tabindex="-1" class="container" data-tab-scope="policies" data-initial-tab="@(bundle is null ? "tab-json" : Model.InitialSection is { } selectedSection ? "tab-" + selectedSection : "")">
    <div class="page-header">
        <div>
            <p class="eyebrow">Firewall / Configuration</p><h1>Firewall</h1>
            <p class="page-subtitle">
                Manage rules, NAT and bridge filtering. Edits remain drafts until you review and save a revision.
            </p>
        </div>
        <div class="btn-group">
            @if (Model.Compatibility is { } compat)
            {
                <span class="badge @(compat.IsCompatible ? "badge-success" : "badge-danger")">
                    @compat.BackendId: @(compat.IsCompatible ? "compatible" : "incompatible")
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.CandidateDigest))
            {
                <span class="badge badge-neutral mono">SHA-256 @Model.CandidateDigest[..12]</span>
            }
        </div>
    </div>

    @if (Model.Diagnostics.Count > 0)
    {
        <div class="alert alert-danger" role="alert">
            <strong>Validation diagnostics (@Model.Diagnostics.Count)</strong>
            <ul style="margin: 0.4rem 0 0; padding-left: 1.25rem;">
                @foreach (var d in Model.Diagnostics)
                {
                    <li><code>@d.Code</code> at <code>@d.Path</code></li>
                }
            </ul>
        </div>
    }

    <details class="disclosure mb-0 mt-2">
        <summary>Router constructs and apply readiness</summary>
        <p>Use the guided forms for raw rpfilter rules, UDP source ports, forward MSS clamping, MAC matches and negation,
            destination-keyed meters, negated interfaces/prefixes, and postrouting masquerade/return.
            The native diff shows the complete compiled candidate. Existing advanced matchers survive structured edits.</p>
        <p>Independent priority tables and extended bridge jump/return chains support confirmed apply with complete bundle receipts.
            Every owned table is validated and replaced together. Missing confirmation triggers local rollback; unexpected native drift requires manual recovery.</p>
        @if (bundle?.Filter.RpFilter is { } rp)
        { <p><strong>Raw rpfilter:</strong> @rp.Rules.Count ordered rules.</p> }
        @if (bundle?.Filter.ForwardTcpMssClamp is { } mss)
        { <p><strong>Forward TCP SYN MSS:</strong> @mss bytes.</p> }
        @if (bundle?.RequiresExtendedApplySupport == true)
        { <p class="alert alert-info">This draft includes auxiliary tables or extended bridge chains. Use an updated agent with complete bundle receipts; confirmation and local rollback cover the entire bundle.</p> }
    </details>

    <p class="alert alert-info">Rule switches update the draft only. Disabled rules keep their settings and order and are omitted from the native candidate. Review the intent/native diffs, save a revision, then use confirmed apply. Disabling a rule can broaden or restrict traffic.</p>

    <!-- Top Save / Preview Bar -->
    <section class="card">
        <form method="post" action="@Url.Content("~/manage/policies/preview")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="bundleJson" value="@Model.BundleJson" />
            <div class="form-grid">
                <div class="field span-2">
                    <label for="top-summary">Revision summary / change note</label>
                    <input id="top-summary" type="text" name="summary" value="@Model.Summary" placeholder="e.g. Allow HTTPS + ICMPv4 diagnostics on WAN" maxlength="@Nergal.Web.PolicyEditorViewModel.MaximumSummaryLength" />
                </div>
                <div class="field">
                    <label for="top-compare">Compare diff against</label>
                    <select id="top-compare" name="compareToRevision">
                        <option value="">(empty baseline)</option>
                        @foreach (var rev in Model.Revisions)
                        {
                            <option value="@rev.Revision" selected="@(Model.CompareToRevision == rev.Revision)">
                                Rev @rev.Revision (@rev.CandidateDigest[..8])
                            </option>
                        }
                    </select>
                </div>
                <div class="field">
                    <div class="btn-group">
                        <button type="submit" class="btn btn-secondary">Preview diff</button>
                        @if (Model.CanMutate)
                        {
                            <button type="submit" class="btn btn-success" formaction="@Url.Content("~/manage/policies/save")">Save policy revision</button>
                        }
                    </div>
                </div>
            </div>
        </form>
    </section>

    <!-- Section Tabs -->
    <div class="tabs" role="tablist" aria-label="Policy bundle sections">
        <button type="button" class="tab-btn active" role="tab" data-tab-target="tab-filter">Rules (@filterCount)</button>
        <button type="button" class="tab-btn" role="tab" data-tab-target="tab-nat">NAT (@natCount)</button>
        <button type="button" class="tab-btn" role="tab" data-tab-target="tab-bridge">Bridge (@bridgeCount)</button>
        <button type="button" class="tab-btn" role="tab" data-tab-target="tab-preview">Review &amp; export</button>
        <button type="button" class="tab-btn" role="tab" data-tab-target="tab-json">Advanced JSON &amp; Revisions</button>
    </div>

    <!-- TAB 1: FILTER -->
    <div class="tab-panel" id="tab-filter" tabindex="-1" data-tab-panel="tab-filter">
        @if (Model.CanMutate && bundle is not null)
        {
            <details class="card settings-disclosure"><summary>Default actions and policy version</summary>
                <div class="card-header">
                    <h2>Filter chain defaults (<code>inet nergal_filter</code>)</h2>
                    <span class="badge badge-primary">Schema v@(bundle.Filter.SchemaVersion)</span>
                </div>
                <form method="post" action="@Url.Content("~/manage/policies/filter/defaults")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bundleJson" value="@Model.BundleJson" />
                    <input type="hidden" name="summary" value="@Model.Summary" />
                    <input type="hidden" name="compareToRevision" value="@Model.CompareToRevision" />
                    <div class="form-grid">
                        <div class="field">
                            <label for="f-schema">Schema version</label>
                            <select id="f-schema" name="schemaVersion">
                                <option value="2" selected="@(bundle.Filter.SchemaVersion == 2)">Schema 2 (Multi-chain, stateful, sets)</option>
                                <option value="1" selected="@(bundle.Filter.SchemaVersion == 1)">Schema 1 (Input-only stateless)</option>
                            </select>
                        </div>
                        <div class="field">
                            <label for="f-in-def">Input default</label>
                            <select id="f-in-def" name="inputDefaultVerdict">
                                <option value="drop" selected="@(bundle.Filter.InputDefaultVerdict == FilterVerdict.Drop)">drop</option>
                                <option value="accept" selected="@(bundle.Filter.InputDefaultVerdict == FilterVerdict.Accept)">accept</option>
                            </select>
                        </div>
                        <div class="field">
                            <label for="f-fwd-def">Forward default</label>
                            <select id="f-fwd-def" name="forwardDefaultVerdict">
                                <option value="drop" selected="@(bundle.Filter.ForwardDefaultVerdict == FilterVerdict.Drop)">drop</option>
                                <option value="accept" selected="@(bundle.Filter.ForwardDefaultVerdict == FilterVerdict.Accept)">accept</option>
                            </select>
                        </div>
                        <div class="field">
                            <label for="f-out-def">Output default</label>
                            <select id="f-out-def" name="outputDefaultVerdict">
                                <option value="accept" selected="@(bundle.Filter.OutputDefaultVerdict == FilterVerdict.Accept)">accept</option>
                                <option value="drop" selected="@(bundle.Filter.OutputDefaultVerdict == FilterVerdict.Drop)">drop</option>
                            </select>
                        </div>
                        <div class="field">
                            <button type="submit" class="btn btn-secondary">Update defaults</button>
                        </div>
                    </div>
                </form>
            </details>
        }

        <section class="card">
            <div class="card-header">
                <h2>Filter rules (@filterCount)</h2>
                @if (Model.CanMutate) { <a class="btn btn-secondary btn-sm" href="#new-filter-rule" data-open-details>Add rule</a> }
            </div>
            @if (bundle is null || bundle.Filter.Rules.Count == 0)
            {
                <p class="muted mb-0">No filter rules yet. Add a rule using the form below.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="policy-rules-table rule-state-table">
                        <thead>
                            <tr>
                                <th>#</th><th>Enabled state</th><th>Verdict</th>
                                <th>Chain / interfaces</th>
                                <th>Family / protocol</th>
                                <th>Source</th>
                                <th>Destination</th>
                                <th>Ports</th>
                                <th>Conditions / description</th>
                                @if (Model.CanMutate)
                                {
                                    <th>Order / Edit / Remove</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var idx = 0; idx < bundle.Filter.Rules.Count; idx++)
                            {
                                var r = bundle.Filter.Rules[idx];
                                if (r is null) { continue; }
                                var srcText = r.SourceObject is { } sr ? sr.Content.Name + " v" + sr.Version + " [" + string.Join(", ", sr.Content.Entries) + "]" : r.Source?.Value ?? (r.SourcePrefixes is { Count: > 0 } sp ? "{ " + string.Join(", ", sp.Select(p => p.Value)) + " }" : "any");
                                var dstText = r.DestinationObject is { } dr ? dr.Content.Name + " v" + dr.Version + " [" + string.Join(", ", dr.Content.Entries) + "]" : r.Destination?.Value ?? (r.DestinationPrefixes is { Count: > 0 } dp ? "{ " + string.Join(", ", dp.Select(p => p.Value)) + " }" : "any");
                                var portText = r.DestinationPortObject is { } pr ? pr.Content.Name + " v" + pr.Version + " [" + string.Join(", ", pr.Content.Entries) + "]" : r.DestinationPort?.ToString() ?? (r.DestinationPorts is { Count: > 0 } ps ? "{ " + string.Join(", ", ps) + " }" : "any");
                                var editSources = r.Source?.Value ?? (r.SourcePrefixes is { Count: > 0 } esp ? string.Join(", ", esp.Select(p => p.Value)) : "");
                                var editDests = r.Destination?.Value ?? (r.DestinationPrefixes is { Count: > 0 } edp ? string.Join(", ", edp.Select(p => p.Value)) : "");
                                var editPorts = r.DestinationPort?.ToString() ?? (r.DestinationPorts is { Count: > 0 } eps ? string.Join(", ", eps) : "");
                                var editStatesList = new List<string>();
                                if ((r.ConnectionStates & ConnectionStateFlags.New) != 0) { editStatesList.Add("new"); }
                                if ((r.ConnectionStates & ConnectionStateFlags.Established) != 0) { editStatesList.Add("established"); }
                                if ((r.ConnectionStates & ConnectionStateFlags.Related) != 0) { editStatesList.Add("related"); }
                                if ((r.ConnectionStates & ConnectionStateFlags.Invalid) != 0) { editStatesList.Add("invalid"); }
                                var editStates = string.Join(", ", editStatesList);
                                var ifaceText = (r.InputInterface, r.OutputInterface) switch
                                {
                                    (null, null) => "any",
                                    (string i, null) => $"in:{(r.NegateInputInterface ? "!= " : "")}{i}",
                                    (null, string o) => $"out:{(r.NegateOutputInterface ? "!= " : "")}{o}",
                                    (string i, string o) => $"in:{(r.NegateInputInterface ? "!= " : "")}{i} out:{(r.NegateOutputInterface ? "!= " : "")}{o}",
                                };
                                <tr>
                                    <td>@(idx + 1)</td>
                                    <td>@await Html.PartialAsync("_RuleStateControl", new Nergal.Web.RuleStateControlModel(Model, new(PolicyRuleScope.Filter, idx, null, r.Enabled, "Filter rule " + (idx + 1))))</td>
                                    <td>
                                        <span class="badge @(r.Verdict == FilterVerdict.Accept ? "badge-success" : "badge-danger")">
                                            @r.Verdict.ToString().ToLowerInvariant()
                                        </span>
                                    </td>
                                    <td class="rule-location"><code>@r.Chain.ToString().ToLowerInvariant()</code>
                                        @if (ifaceText != "any") { <span class="rule-desc">@ifaceText</span> }
                                    </td>
                                    <td class="rule-protocol">
                                        <code>@r.Family.ToString().ToLowerInvariant() · @r.Protocol.ToString().ToLowerInvariant()</code>
                                        @if (!string.IsNullOrEmpty(r.IcmpType)) { <span>(<code>@r.IcmpType</code>)</span> }
                                    </td>
                                    <td class="rule-address">
                                        <code>@(r.NegateSource ? "!= " : "")@srcText</code>
                                        @if (r.SourceMac is not null || r.SourceMacs is not null)
                                        {
                                            <span class="rule-desc">MAC @(r.NegateSourceMac ? "!= " : "")@(r.SourceMac?.Value ?? string.Join(", ", r.SourceMacs!.Select(m => m.Value)))</span>
                                        }
                                    </td>
                                    <td class="rule-address"><code>@(r.NegateDestination ? "!= " : "")@dstText</code></td>
                                    <td><code>@portText</code></td>
                                    <td>
                                        @if (r.ConnectionStates != ConnectionStateFlags.None) { <code>@r.ConnectionStates</code> }
                                        @if (r.MatchOriginalDestinationDnat) { <span class="badge badge-warning">ct dnat</span> }
                                        @if (r.RateLimit is { } rl) { <span class="badge badge-neutral">@rl.PacketsPerWindow/@rl.WindowUnit.ToString().ToLowerInvariant() · @(rl.KeyKind == RateLimitKeyKind.DestinationAddress ? "per destination" : "per source")</span> }
                                        @if (r.ConnectionStates == ConnectionStateFlags.None && !r.MatchOriginalDestinationDnat && r.RateLimit is null) { <span class="muted">stateless</span> }
                                        @if (!string.IsNullOrEmpty(r.Description)) { <span class="rule-desc">@r.Description</span> }
                                    </td>


                                    @if (Model.CanMutate)
                                    {
                                        <td>
                                            <div class="btn-group">
                                                @if (idx > 0)
                                                {
                                                    <form class="inline-form" method="post" action="@Url.Content("~/manage/policies/rules/move")">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="bundleJson" value="@Model.BundleJson" />
                                                        <input type="hidden" name="summary" value="@Model.Summary" />
                                                        <input type="hidden" name="compareToRevision" value="@Model.CompareToRevision" />
                                                        <input type="hidden" name="ruleIndex" value="@idx" />
                                                        <input type="hidden" name="direction" value="-1" />
                                                        <button type="submit" class="btn btn-secondary btn-sm" title="Move up">↑</button>
                                                    </form>
                                                }
                                                @if (idx + 1 < bundle.Filter.Rules.Count)
                                                {
                                                    <form class="inline-form" method="post" action="@Url.Content("~/manage/policies/rules/move")">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="bundleJson" value="@Model.BundleJson" />
                                                        <input type="hidden" name="summary" value="@Model.Summary" />
                                                        <input type="hidden" name="compareToRevision" value="@Model.CompareToRevision" />
                                                        <input type="hidden" name="ruleIndex" value="@idx" />
                                                        <input type="hidden" name="direction" value="1" />
                                                        <button type="submit" class="btn btn-secondary btn-sm" title="Move down">↓</button>
                                                    </form>
                                                }
                                                <details class="inline-edit-details">
                                                    <summary class="btn btn-secondary btn-sm">Edit</summary>
                                                    <div class="inline-edit-popover">
                                                        <form method="post" action="@Url.Content("~/manage/policies/rules/edit")">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="bundleJson" value="@Model.BundleJson" />
                                                            <input type="hidden" name="summary" value="@Model.Summary" />
                                                            <input type="hidden" name="compareToRevision" value="@Model.CompareToRevision" />
                                                            <input type="hidden" name="ruleIndex" value="@idx" />
                                                            <div class="form-grid">
                                                                <div class="field">
                                                                    <label for="filter-edit-@idx-chain">Chain</label>
                                                                    <select name="chain" id="filter-edit-@idx-chain">
                                                                        <option value="input" selected="@(r.Chain == FilterChainKind.Input)">input</option>
                                                                        <option value="forward" selected="@(r.Chain == FilterChainKind.Forward)">forward</option>
                                                                        <option value="output" selected="@(r.Chain == FilterChainKind.Output)">output</option>
                                                                    </select>
                                                                </div>
                                                                <div class="field">
                                                                    <label for="filter-edit-@idx-family">Family</label>
                                                                    <select name="family" id="filter-edit-@idx-family">
                                                                        <option value="ipv4" selected="@(r.Family == IpFamily.IPv4)">ipv4</option>
                                                                        <option value="ipv6" selected="@(r.Family == IpFamily.IPv6)">ipv6</option>
                                                                    </select>
                                                                </div>
                                                                <div class="field">
                                                                    <label for="filter-edit-@idx-protocol">Protocol</label>
                                                                    <select name="protocol" id="filter-edit-@idx-protocol">
                                                                        <option value="tcp" selected="@(r.Protocol == FilterProtocol.Tcp)">tcp</option>
                                                                        <option value="udp" selected="@(r.Protocol == FilterProtocol.Udp)">udp</option>
                                                                        <option value="icmp" selected="@(r.Protocol == FilterProtocol.Icmp)">icmp</option>
                                                                        <option value="icmpv6" selected="@(r.Protocol == FilterProtocol.IcmpV6)">icmpv6</option>
                                                                        <option value="any" selected="@(r.Protocol == FilterProtocol.Any)">any</option>
                                                                    </select>
                                                                </div>
                                                                <div class="field">
                                                                    <label for="filter-edit-@idx-verdict">Verdict</label>
                                                                    <select name="verdict" id="filter-edit-@idx-verdict">
                                                                        <option value="accept" selected="@(r.Verdict == FilterVerdict.Accept)">accept</option>
                                                                        <option value="drop" selected="@(r.Verdict == FilterVerdict.Drop)">drop</option>
                                                                        <option value="reject" selected="@(r.Verdict == FilterVerdict.Reject)">reject — ICMP admin prohibited</option>
                                                                    </select>
                                                                </div>
                                                                <div class="field span-2">
                                                                    <label for="filter-edit-@idx-sources">Source CIDR(s)</label>
                                                                    <input type="text" name="sources" value="@editSources" readonly="@(r.SourceObject is not null)" aria-label="Source literals; pinned lists are managed separately" id="filter-edit-@idx-sources" />
                                                                </div>
                                                                <div class="field span-2">
                                                                    <label for="filter-edit-@idx-destinations">Destination CIDR(s)</label>
                                                                    <input type="text" name="destinations" value="@editDests" readonly="@(r.DestinationObject is not null)" aria-label="Destination literals; pinned lists are managed separately" id="filter-edit-@idx-destinations" />
                                                                </div>
                                                                <div class="field">
                                                                    <label for="filter-edit-@idx-destinationPorts">Dest port(s)</label>
                                                                    <input type="text" name="destinationPorts" value="@editPorts" readonly="@(r.DestinationPortObject is not null)" aria-label="Port literals; pinned lists are managed separately" id="filter-edit-@idx-destinationPorts" />
                                                                </div>
                                                                <div class="field">
                                                                    <label for="filter-edit-@idx-icmpType">ICMP type</label>
                                                                    <input type="text" name="icmpType" value="@r.IcmpType" id="filter-edit-@idx-icmpType" />
                                                                </div>
                                                                <div class="field">
                                                                    <label for="filter-edit-@idx-inputInterface">Input iface</label>
                                                                    <input type="text" name="inputInterface" value="@r.InputInterface" maxlength="15" id="filter-edit-@idx-inputInterface" />
                                                                </div>
                                                                <div class="field">
                                                                    <label for="filter-edit-@idx-outputInterface">Output iface</label>
                                                                    <input type="text" name="outputInterface" value="@r.OutputInterface" maxlength="15" id="filter-edit-@idx-outputInterface" />
                                                                </div>
                                                                <div class="field span-2">
                                                                    <label for="filter-edit-@idx-connectionStates">CT states (comma-separated: new, established, related, invalid)</label>
                                                                    <input type="text" name="connectionStates" value="@editStates" id="filter-edit-@idx-connectionStates" />
                                                                </div>
                                                                <div class="field span-2">
                                                                    <label for="filter-edit-@idx-description">Description (optional)</label>
                                                                    <input type="text" name="description" value="@r.Description" maxlength="160" placeholder="Purpose of this rule" id="filter-edit-@idx-description" />
                                                                </div>
                                                                <div class="field">
                                                                    <label for="filter-edit-@idx-rateLimitPackets">Rate limit pkts</label>
                                                                    <input type="number" name="rateLimitPackets" value="@r.RateLimit?.PacketsPerWindow" min="1" max="1000000" id="filter-edit-@idx-rateLimitPackets" />
                                                                </div>
                                                                <div class="field">
                                                                    <label for="filter-edit-@idx-rateLimitUnit">Rate limit unit</label>
                                                                    <select name="rateLimitUnit" id="filter-edit-@idx-rateLimitUnit">
                                                                        <option value="second" selected="@(r.RateLimit?.WindowUnit != RateLimitTimeUnit.Minute)">second</option>
                                                                        <option value="minute" selected="@(r.RateLimit?.WindowUnit == RateLimitTimeUnit.Minute)">minute</option>
                                                                    </select>
                                                                </div>
                                                                <div class="field">
                                                                    <label for="filter-edit-@idx-rateLimitBurst">Rate limit burst</label>
                                                                    <input type="number" name="rateLimitBurst" value="@r.RateLimit?.Burst" min="1" max="10000" id="filter-edit-@idx-rateLimitBurst" />
                                                                </div>
                                                                <div class="field">
                                                                    <label for="filter-edit-@idx-rateLimitTimeout">Rate limit timeout</label>
                                                                    <input type="number" name="rateLimitTimeout" value="@(r.RateLimit?.EntryTimeoutSeconds ?? 60)" min="1" max="86400" id="filter-edit-@idx-rateLimitTimeout" />
                                                                </div>
                                                                <div class="field span-2">
                                                                    <label class="checkbox-row">
                                                                        <input type="checkbox" name="matchOriginalDestinationDnat" value="true" checked="@r.MatchOriginalDestinationDnat" />
                                                                        Match DNAT (<code>ct status dnat</code>)
                                                                    </label>
                                                                </div>
                                                            </div>
                                                            <div class="mt-2">
                                                                <button type="submit" class="btn btn-sm">Save rule #@(idx + 1)</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </details>
                                                <form class="inline-form" method="post" action="@Url.Content("~/manage/policies/rules/remove")">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="bundleJson" value="@Model.BundleJson" />
                                                    <input type="hidden" name="summary" value="@Model.Summary" />
                                                    <input type="hidden" name="compareToRevision" value="@Model.CompareToRevision" />
                                                    <input type="hidden" name="ruleIndex" value="@idx" />
                                                    <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                                                </form>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @if (Model.CanMutate)
        {
            <details class="card settings-disclosure" id="new-filter-rule" open="@(filterCount == 0)"><summary>Add filter rule</summary>
                <div class="card-header">
                    <h2>Add filter rule</h2>
                    <span class="badge badge-neutral">Supports inline CIDR/port sets &amp; rate limiting</span>
                </div>
                <form method="post" action="@Url.Content("~/manage/policies/rules/add")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bundleJson" value="@Model.BundleJson" />
                    <input type="hidden" name="summary" value="@Model.Summary" />
                    <input type="hidden" name="compareToRevision" value="@Model.CompareToRevision" />

                    <div class="form-grid">
                        <div class="field">
                            <label for="r-chain">Chain</label>
                            <select id="r-chain" name="chain">
                                <option value="input">input</option>
                                <option value="forward">forward</option>
                                <option value="output">output</option>
                            </select>
                        </div>
                        <div class="field">
                            <label for="r-family">IP Family</label>
                            <select id="r-family" name="family">
                                <option value="ipv4">ipv4</option>
                                <option value="ipv6">ipv6</option>
                            </select>
                        </div>
                        <div class="field">
                            <label for="r-protocol">Protocol</label>
                            <select id="r-protocol" name="protocol" data-filter-protocol>
                                <option value="tcp">tcp</option>
                                <option value="udp">udp</option>
                                <option value="icmp">icmp (IPv4)</option>
                                <option value="icmpv6">icmpv6 (IPv6)</option>
                                <option value="any">any</option>
                            </select>
                        </div>
                        <div class="field">
                            <label for="r-verdict">Verdict</label>
                            <select id="r-verdict" name="verdict">
                                <option value="accept">accept</option>
                                <option value="drop">drop</option>

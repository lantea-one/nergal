                    </div>
                    <div class="mt-2"><button type="submit">Add bridge rule</button></div>
                </form>
            }
        </section>
    </div>

    <!-- TAB 4: CANDIDATE & DIFF -->
    <div class="tab-panel" data-tab-panel="tab-preview">
        @if (bundle is not null)
        {
            <component type="typeof(Nergal.Web.Components.PolicyBundleSummary)" render-mode="Static" param-Bundle="bundle" />
        }

        @if (!string.IsNullOrEmpty(Model.CandidateText))
        {
            <section class="card">
                <div class="card-header">
                    <h2>Compiled nftables candidate</h2>
                    <span class="badge badge-neutral mono">SHA-256 @Model.CandidateDigest</span>
                </div>
                <pre>@Model.CandidateText</pre>
            </section>
        }

        @if (!string.IsNullOrEmpty(Model.UnifiedDiff))
        {
            <section class="card">
                <div class="card-header">
                    <h2>Unified diff preview</h2>
                </div>
                <pre class="diff-view">@Model.UnifiedDiff</pre>
            </section>
        }
    </div>

    <!-- TAB 5: ADVANCED JSON & SAVED REVISIONS -->
    <div class="tab-panel" data-tab-panel="tab-json">
        <section class="card">
            <div class="card-header">
                <h2>Advanced JSON bundle editor</h2>
                <span class="badge badge-neutral">Canonical FirewallPolicyBundle</span>
            </div>
            <form method="post" action="@Url.Content("~/manage/policies/preview")">
                @Html.AntiForgeryToken()
                <div class="form-grid" style="margin-bottom: 0.9rem;">
                    <div class="field">
                        <label>Compare against revision</label>
                        <select name="compareToRevision">
                            <option value="">(empty baseline)</option>
                            @foreach (var rev in Model.Revisions)
                            {
                                <option value="@rev.Revision" selected="@(Model.CompareToRevision == rev.Revision)">Revision @rev.Revision (@rev.CandidateDigest[..8])</option>
                            }
                        </select>
                    </div>
                    <div class="field span-2">
                        <label>Summary</label>
                        <input type="text" name="summary" value="@Model.Summary" maxlength="256" />
                    </div>
                </div>
                <div class="field">
                    <label for="raw-bundle-json">Bundle JSON</label>
                    <p id="bundle-editor-help" class="muted">JSON syntax highlighting, folding and error markers. Use Ctrl+F (Cmd+F on Mac) to search. Tab moves to the next control. Preview validates policy semantics.</p>
                    <textarea id="raw-bundle-json" class="code-editor" name="bundleJson" data-code-editor="json" data-editor-label="Policy bundle JSON" aria-describedby="bundle-editor-help">@Model.BundleJson</textarea>
                </div>
                <div class="btn-group mt-2">
                    <button type="submit" class="btn btn-secondary">Preview compatibility &amp; nftables diff</button>
                    @if (Model.CanMutate)
                    {
                        <button type="submit" class="btn btn-success" formaction="@Url.Content("~/manage/policies/save")">Save policy revision</button>
                    }
                </div>
            </form>
        </section>

        <section class="card">
            <div class="card-header">
                <h2>Saved policy revisions (@Model.Revisions.Count)</h2>
            </div>
            @if (Model.Revisions.Count == 0)
            {
                <p class="muted mb-0">No policy revisions persisted yet.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Revision</th>
                                <th>Candidate SHA-256</th>
                                <th>Created by</th>
                                <th>Timestamp (local time)</th>
                                <th>Summary</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rev in Model.Revisions)
                            {
                                <tr>
                                    <td><a class="btn btn-secondary btn-sm" href="@Url.Content($"~/manage/policies?revision={rev.Revision}")">Load Rev @rev.Revision</a></td>
                                    <td><code>@rev.CandidateDigest</code></td>
                                    <td><code>@rev.CreatedByActor</code></td>
                                    <td class="mono">@await Html.PartialAsync("_LocalTime", rev.CreatedAtUtc)</td>
                                    <td>@(rev.Summary ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</main>

@section Scripts {
    <script src="@Url.Content("~/js/code-editor.bundle.js")" asp-append-version="true" defer></script>
}

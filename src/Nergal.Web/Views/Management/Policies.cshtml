                                <option value="echo-reply">echo-reply (IPv4 &amp; IPv6)</option>
                                <option value="destination-unreachable">destination-unreachable (IPv4 &amp; IPv6)</option>
                                <option value="time-exceeded">time-exceeded (IPv4 &amp; IPv6)</option>
                                <option value="parameter-problem">parameter-problem (IPv4 &amp; IPv6)</option>
                                <option value="packet-too-big">packet-too-big (IPv6)</option>
                                <option value="nd-router-solicit">nd-router-solicit (IPv6 ND)</option>
                                <option value="nd-router-advert">nd-router-advert (IPv6 ND)</option>
                                <option value="nd-neighbor-solicit">nd-neighbor-solicit (IPv6 ND)</option>
                                <option value="nd-neighbor-advert">nd-neighbor-advert (IPv6 ND)</option>
                            </select>
                        </div>

                        <div class="field">
                            <label for="r-iif">Input interface (<code>iifname</code>)</label>
                            <input id="r-iif" type="text" name="inputInterface" placeholder="eth0" maxlength="15" />
                        </div>
                        <div class="field">
                            <label for="r-oif">Output interface (<code>oifname</code>)</label>
                            <input id="r-oif" type="text" name="outputInterface" placeholder="wan0" maxlength="15" />
                        </div>
                        <div class="field form-full">
                            <label for="r-desc">Description (optional)</label>
                            <input id="r-desc" type="text" name="description" placeholder="Allow HTTPS ingress from management subnet" maxlength="160" />
                        </div>
                    </div>

                    <div class="mt-2">
                        <label class="field-label">Connection tracking states (<code>ct state</code>)</label>
                        <input type="hidden" name="connectionStates" value="" data-ct-state-value />
                        <div class="checkbox-group mt-1">
                            <label class="checkbox-row"><input type="checkbox" value="new" data-ct-state-cb /> new</label>
                            <label class="checkbox-row"><input type="checkbox" value="established" data-ct-state-cb /> established</label>
                            <label class="checkbox-row"><input type="checkbox" value="related" data-ct-state-cb /> related</label>
                            <label class="checkbox-row"><input type="checkbox" value="invalid" data-ct-state-cb /> invalid</label>
                            <label class="checkbox-row" style="margin-left: 1rem;">
                                <input type="checkbox" name="matchOriginalDestinationDnat" value="true" /> Match DNAT (<code>ct status dnat</code>)
                            </label>
                        </div>
                    </div>

                    <details class="disclosure mt-2">
                        <summary>Optional: Per-source token-bucket rate limit (dynamic nftables set)</summary>
                        <div class="form-grid mt-2">
                            <div class="field">
                                <label for="rl-packets">Packets per window</label>
                                <input id="rl-packets" type="number" name="rateLimitPackets" min="1" max="1000000" placeholder="e.g. 20" />
                            </div>
                            <div class="field">
                                <label for="rl-unit">Window unit</label>
                                <select id="rl-unit" name="rateLimitUnit">
                                    <option value="second">per second</option>
                                    <option value="minute">per minute</option>
                                </select>
                            </div>
                            <div class="field">
                                <label for="rl-burst">Burst (packets)</label>
                                <input id="rl-burst" type="number" name="rateLimitBurst" min="1" max="10000" placeholder="e.g. 10" />
                            </div>
                            <div class="field">
                                <label for="rl-timeout">Entry timeout (seconds)</label>
                                <input id="rl-timeout" type="number" name="rateLimitTimeout" min="1" max="86400" value="60" />
                            </div>
                        </div>
                    </details>

                    <div class="mt-2">
                        <button type="submit">Add filter rule to draft</button>
                    </div>
                </form>
            </details>
        }
        @if (Model.CanMutate && bundle is not null && bundle.Filter.Rules.Count > 0)
        {
            <details class="card settings-disclosure"><summary>MAC, negation and meter conditions</summary>
                <h2 id="filter-conditions-heading">MAC, negation &amp; meter conditions</h2>
                @for (var i = 0; i < bundle.Filter.Rules.Count; i++)
                {
                    if (bundle.Filter.Rules[i] is not null)
                    { @await Html.PartialAsync("_FilterConditions", new Nergal.Web.FilterConditionsFormModel(Model, i)) }
                }
            </details>
        }

        <details class="disclosure mb-0 mt-2"><summary>Early filtering table</summary>@await Html.PartialAsync("_AuxiliaryForms", Model)</details>
        <details class="disclosure mb-0 mt-2"><summary>Reverse-path filtering and TCP MSS</summary>@await Html.PartialAsync("_RawMssForms", Model)</details>
        @await Html.PartialAsync("_AdvancedRuleStates", Model)
        <details class="disclosure mb-0 mt-2"><summary>Alias references and pinned list versions</summary>@await Html.PartialAsync("_PolicyObjects", Model)</details>


    </div>

    <!-- TAB 2: NAT -->
    <div class="tab-panel" id="tab-nat" tabindex="-1" data-tab-panel="tab-nat">
        <section class="card">
            <div class="card-header">
                <h2>Prerouting DNAT rules (<code>inet nergal_nat</code>)</h2>
                @if (Model.CanMutate && bundle?.Nat is not null)
                {
                    <form class="inline-form" method="post" action="@Url.Content("~/manage/policies/nat/clear")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bundleJson" value="@Model.BundleJson" />
                        <input type="hidden" name="summary" value="@Model.Summary" />
                        <input type="hidden" name="compareToRevision" value="@Model.CompareToRevision" />
                        <button type="submit" class="btn btn-danger btn-sm">Clear entire NAT section</button>
                    </form>
                }
            </div>
            @if (bundle?.Nat is null || bundle.Nat.DnatRules.Count == 0)
            {
                <p class="muted mb-0">No prerouting DNAT rules defined.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th><th>Enabled state</th>
                                <th>Family</th>
                                <th>Protocol</th>
                                <th>Original Dest</th>
                                <th>Translated Addr</th>
                                <th>Ports</th>
                                <th>Iface / Source</th>
                                <th>Description</th>
                                @if (Model.CanMutate) { <th>Action</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < bundle.Nat.DnatRules.Count; i++)
                            {
                                var d = bundle.Nat.DnatRules[i];
                                if (d is null) { continue; }
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@await Html.PartialAsync("_RuleStateControl", new Nergal.Web.RuleStateControlModel(Model, new(PolicyRuleScope.Dnat, i, null, d.Enabled, "Dnat rule " + (i + 1))))</td>
                                    <td><code>@d.Family.ToString().ToLowerInvariant()</code></td>
                                    <td><code>@d.Protocol.ToString().ToLowerInvariant()</code></td>
                                    <td><code>@(d.NegateDestination ? "!= " : "")@(d.DestinationObject is { } destinationPin ? destinationPin.Content.Name + " v" + destinationPin.Version + " [" + string.Join(", ", destinationPin.Content.Entries) + "]" : d.OriginalDestination?.Value ?? string.Join(", ", d.DestinationPrefixes!.Select(p => p.Value)))</code></td>
                                    <td><code>@d.TranslatedAddress</code></td>
                                    <td><code>@(d.OriginalPortObject is { } portPin ? portPin.Content.Name + " v" + portPin.Version : d.OriginalPort?.ToString() ?? (d.OriginalPorts is { } originalSet ? string.Join(", ", originalSet) : "any")) → @(d.TranslatedPort?.ToString() ?? "same")</code></td>
                                    <td><code>@(d.NegateInputInterface ? "!= " : "")@(d.InputInterface ?? "any")</code> · <code>@(d.NegateSource ? "!= " : "")@(d.SourceObject is { } sourcePin ? sourcePin.Content.Name + " v" + sourcePin.Version + " [" + string.Join(", ", sourcePin.Content.Entries) + "]" : d.Source?.Value ?? (d.SourcePrefixes is { } sources ? string.Join(", ", sources.Select(p => p.Value)) : "any"))</code></td>

                                    <td>@(string.IsNullOrEmpty(d.Description) ? "—" : d.Description)</td>
                                    @if (Model.CanMutate)
                                    {
                                        <td>
                                            <div class="btn-group">
                                                @await Html.PartialAsync("_NatRuleMove", new Nergal.Web.NatRuleMoveModel(Model, "dnat", i, bundle.Nat.DnatRules.Count))
                                                <a class="btn btn-secondary btn-sm" href="#dnat-editor-@i">Edit DNAT #@(i + 1)</a>
                                                <form class="inline-form" method="post" action="@Url.Content("~/manage/policies/nat/dnat/remove")">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="bundleJson" value="@Model.BundleJson" />
                                                    <input type="hidden" name="summary" value="@Model.Summary" />
                                                    <input type="hidden" name="compareToRevision" value="@Model.CompareToRevision" />
                                                    <input type="hidden" name="ruleIndex" value="@i" />
                                                    <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                                                </form>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @await Html.PartialAsync("_DnatEditors", Model)

            @if (Model.CanMutate)
            {
                <h3 class="mt-2">Add DNAT rule</h3>
                <form class="router-form" method="post" action="@Url.Content("~/manage/policies/nat/dnat/add")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bundleJson" value="@Model.BundleJson" />
                    <input type="hidden" name="summary" value="@Model.Summary" />
                    <input type="hidden" name="compareToRevision" value="@Model.CompareToRevision" />
                    <div class="form-grid">
                        <div class="field">
                            <label for="dnat-new-family">Family</label>
                            <select name="family" id="dnat-new-family"><option value="ipv4">ipv4</option><option value="ipv6">ipv6</option></select>
                        </div>
                        <div class="field">
                            <label for="dnat-new-protocol">Protocol</label>
                            <select name="protocol" id="dnat-new-protocol"><option value="tcp">tcp</option><option value="udp">udp</option><option value="any">any</option></select>
                        </div>
                        <div class="field">
                            <label for="dnat-new-originalDestination">Original destination CIDR(s)</label>
                            <input type="text" name="originalDestination" placeholder="192.0.2.1/32" required id="dnat-new-originalDestination" aria-describedby="dnat-new-originalDestination-hint" /><span class="hint" id="dnat-new-originalDestination-hint">Required before translation. One CIDR or 2–64 disjoint/non-adjacent CIDRs of the selected family; every match uses the same translated target.</span>
                        </div>
                        <div class="field">
                            <label for="dnat-new-translatedAddress">Translated IP address</label>
                            <input type="text" name="translatedAddress" placeholder="198.51.100.2" required id="dnat-new-translatedAddress" />
                        </div>
                        <div class="field">
                            <label for="dnat-new-originalPort">Original destination port(s) (optional)</label>
                            <input type="text" name="originalPorts" placeholder="80,443" id="dnat-new-originalPort" aria-describedby="dnat-new-originalPort-hint" />
                            <span class="hint" id="dnat-new-originalPort-hint">One port or 2–64 distinct comma-separated ports, 1–65535; requires TCP or UDP. Every original port maps to the same target; leave blank for any.</span>
                        </div>
                        <div class="field">
                            <label for="dnat-new-translatedPort">Translated port (optional)</label>
                            <input type="number" name="translatedPort" min="1" max="65535" placeholder="8443" id="dnat-new-translatedPort" />
                        </div>
                        <div class="field">
                            <label for="dnat-new-inputInterface">Input interface (optional)</label>
                            <input type="text" name="inputInterface" placeholder="wan0" maxlength="15" id="dnat-new-inputInterface" />
                        </div>
                        <div class="field">
                            <label for="dnat-new-source">Source CIDR(s) (optional)</label>
                            <input type="text" name="source" placeholder="203.0.113.0/24" id="dnat-new-source" aria-describedby="dnat-new-source-hint" /><span class="hint" id="dnat-new-source-hint">Empty means any; one CIDR or 2–64 disjoint/non-adjacent CIDRs of the selected family.</span>
                        </div>
                        <div class="field span-2">
                            <label for="dnat-new-description">Description (optional)</label>
                            <input type="text" name="description" placeholder="Forward HTTPS to reverse proxy" maxlength="160" id="dnat-new-description" />
                        </div>
                    </div>
                    <div class="mt-2"><button type="submit">Add DNAT rule</button></div>
                </form>
            }
        </section>

        @if (bundle?.Nat is { } dnatPolicy)
        { @await Html.PartialAsync("_TransportReferences", new Nergal.Web.TransportReferenceFormModel(Model, "dnat", null, dnatPolicy.DnatRules.Select((r, i) => new Nergal.Web.TransportReferenceRuleOption(i, "Rule " + (i + 1) + " · " + r?.Family + " · " + r?.Protocol)).ToArray())) }

        @await Html.PartialAsync("_DnatConditions", Model)

        <section class="card">
            <div class="card-header">
                <h2>Postrouting NAT rules (<code>inet nergal_nat</code>)</h2>
            </div>
            @if (bundle?.Nat is null || bundle.Nat.SnatRules.Count == 0)
            {
                <p class="muted mb-0">No postrouting rules defined.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th><th>Enabled state</th>
                                <th>Family</th>
                                <th>Source CIDR</th>
                                <th>Action / translated source</th>
                                <th>Destination CIDR</th>
                                <th>Interfaces</th><th>Protocol / destination ports</th>
                                <th>Description</th>
                                @if (Model.CanMutate) { <th>Action</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < bundle.Nat.SnatRules.Count; i++)
                            {
                                var s = bundle.Nat.SnatRules[i];
                                if (s is null) { continue; }
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@await Html.PartialAsync("_RuleStateControl", new Nergal.Web.RuleStateControlModel(Model, new(PolicyRuleScope.Postrouting, i, null, s.Enabled, "Postrouting rule " + (i + 1))))</td>
                                    <td><code>@s.Family.ToString().ToLowerInvariant()</code></td>
                                    <td><code>@(s.NegateSource ? "!= " : "")@(s.SourceObject is { } sourcePin ? sourcePin.Content.Name + " v" + sourcePin.Version + " [" + string.Join(", ", sourcePin.Content.Entries) + "]" : s.Source?.Value ?? (s.SourcePrefixes is { } sourceSet ? "{ " + string.Join(", ", sourceSet.Select(p => p.Value)) + " }" : "any"))</code></td>
                                    <td><code>@(s.Action == NatPostroutingAction.Snat ? s.TranslatedAddress : s.Action.ToString().ToLowerInvariant())</code></td>
                                    <td><code>@(s.NegateDestination ? "!= " : "")@(s.DestinationObject is { } destinationPin ? destinationPin.Content.Name + " v" + destinationPin.Version + " [" + string.Join(", ", destinationPin.Content.Entries) + "]" : s.Destination?.Value ?? (s.DestinationPrefixes is { } destinationSet ? "{ " + string.Join(", ", destinationSet.Select(p => p.Value)) + " }" : "any"))</code></td>
                                    <td><code>in @(s.NegateInputInterface ? "!= " : "")@(s.InputInterface ?? "any") · out @(s.NegateOutputInterface ? "!= " : "")@(s.OutputInterface ?? "any")</code></td>
                                    <td><code>@s.Protocol · @(s.DestinationPortObject is { } portList ? portList.Content.Name + " v" + portList.Version + " [" + string.Join(", ", portList.Content.Entries) + "]" : s.DestinationPort?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? (s.DestinationPorts is null ? "any" : string.Join(", ", s.DestinationPorts)))</code></td>

                                    <td>@(string.IsNullOrEmpty(s.Description) ? "—" : s.Description)</td>
                                    @if (Model.CanMutate)
                                    {
                                        <td>
                                            <div class="btn-group">
                                                @await Html.PartialAsync("_NatRuleMove", new Nergal.Web.NatRuleMoveModel(Model, "postrouting", i, bundle.Nat.SnatRules.Count))
                                                <a class="btn btn-secondary btn-sm" href="#postrouting-editor-@i">Edit postrouting #@(i + 1)</a>
                                                <form class="inline-form" method="post" action="@Url.Content("~/manage/policies/nat/snat/remove")">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="bundleJson" value="@Model.BundleJson" />
                                                    <input type="hidden" name="summary" value="@Model.Summary" />
                                                    <input type="hidden" name="compareToRevision" value="@Model.CompareToRevision" />
                                                    <input type="hidden" name="ruleIndex" value="@i" />
                                                    <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                                                </form>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (Model.CanMutate)
            {
                @if (bundle?.Nat is not null)
                {
                    @for (var i = 0; i < bundle.Nat.SnatRules.Count; i++)
                    {
                        if (bundle.Nat.SnatRules[i] is { } rule)
                        {
                            <details class="router-form-details" id="postrouting-editor-@i">
                                <summary>Edit postrouting #@(i + 1) · @rule.Family · @rule.Action · @(rule.Description ?? "No description")</summary>
                                <div class="router-form-body">@await Html.PartialAsync("_PostroutingForm", new Nergal.Web.PostroutingFormModel(Model, i))</div>
                            </details>
                        }
                    }
                }
                <h3 class="mt-2">Add postrouting rule</h3>
                @await Html.PartialAsync("_PostroutingForm", new Nergal.Web.PostroutingFormModel(Model, null))
            }
        </section>
        @if (Model.CanMutate && bundle?.Nat is { SnatRules.Count: > 0 } portNat)
        {
            <section class="card"><h2>Reusable postrouting lists</h2>
                @await Html.PartialAsync("_TransportReferences", new Nergal.Web.TransportReferenceFormModel(Model, "postrouting", null, portNat.SnatRules.Select((r, i) => new Nergal.Web.TransportReferenceRuleOption(i, "Rule " + (i + 1) + " · " + r?.Family + " · " + r?.Protocol + " · " + r?.Action)).ToArray()))
            </section>
        }
    </div>

    <!-- TAB 3: BRIDGE -->
    <div class="tab-panel" id="tab-bridge" tabindex="-1" data-tab-panel="tab-bridge">
        @await Html.PartialAsync("_BridgeForms", Model)
    </div>

    <!-- TAB 4: CANDIDATE & DIFF -->
    <div class="tab-panel" id="tab-preview" tabindex="-1" data-tab-panel="tab-preview">
        @if (Model.CanMutate && Model.Revisions.Count > 0)
        {
            <section class="card" aria-labelledby="export-heading">
                <h2 id="export-heading">Export a saved revision</h2>
                <p id="export-help" class="hint">Select a saved database revision. Unsaved draft changes are excluded. The native file contains active policy only;
                    the intent file also retains disabled rules, descriptions and pinned lists. These downloads describe desired configuration, not current host state.</p>
                <form method="get" action="@Url.Content("~/manage/policies/export/native")" class="form-grid">
                    <div class="field">
                        <label for="export-revision">Saved revision</label>
                        <select id="export-revision" name="revision" aria-describedby="export-help">
                            @foreach (var saved in Model.Revisions)
                            {
                                <option value="@saved.Revision" selected="@(Model.SelectedRevision == saved.Revision)">Revision @saved.Revision · @(saved.Summary ?? saved.CandidateDigest[..12])</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <div class="btn-group">
                            <button type="submit" class="btn btn-secondary">Download nftables.conf</button>
                            <button type="submit" class="btn btn-secondary" formaction="@Url.Content("~/manage/policies/export/intent")">Download policy intent</button>
                        </div>
                    </div>
                </form>
                <p class="hint">The native file creates reserved Nergal tables and fails if they already exist. Managed updates use confirmed apply.
                    Keep the intent file to preserve authored settings; it is not a backup of library history, accounts or agent ownership.</p>
            </section>
        }
        @if (bundle is not null)
        {
            <component type="typeof(Nergal.Web.Components.PolicyBundleSummary)" render-mode="Static" param-Bundle="bundle" />
        }

        @if (!string.IsNullOrEmpty(Model.CandidateText))
        {
            <section class="card">
                <div class="card-header">
                    <h2>Compiled nftables candidate</h2>
                    <span class="badge badge-neutral mono">SHA-256 @Model.CandidateDigest</span>
                </div>
                <pre>@Model.CandidateText</pre>
            </section>
        }

        @if (!string.IsNullOrEmpty(Model.IntentDiff))
        {
            <section class="card"><h2>Intent diff — enabled state and retained settings</h2>
                <p class="hint">This includes dormant rules and pinned references, which cannot be reconstructed from kernel observations. A state change is still a draft until saved and applied.</p>
                <pre class="diff-view">@Model.IntentDiff</pre>
            </section>
        }
        @if (!string.IsNullOrEmpty(Model.UnifiedDiff))
        {
            <section class="card">
                <div class="card-header">
                    <h2>Unified diff preview</h2>
                </div>
                <pre class="diff-view">@Model.UnifiedDiff</pre>
            </section>
        }
    </div>

    <!-- TAB 5: ADVANCED JSON & SAVED REVISIONS -->
    <div class="tab-panel" id="tab-json" tabindex="-1" data-tab-panel="tab-json">
        <section class="card">
            <div class="card-header">
                <h2>Advanced JSON bundle editor</h2>
                <span class="badge badge-neutral">Canonical FirewallPolicyBundle</span>
            </div>
            <form method="post" action="@Url.Content("~/manage/policies/preview")">
                @Html.AntiForgeryToken()
                <div class="form-grid" style="margin-bottom: 0.9rem;">
                    <div class="field">
                        <label>Compare against revision</label>
                        <select name="compareToRevision">
                            <option value="">(empty baseline)</option>
                            @foreach (var rev in Model.Revisions)
                            {
                                <option value="@rev.Revision" selected="@(Model.CompareToRevision == rev.Revision)">Revision @rev.Revision (@rev.CandidateDigest[..8])</option>
                            }
                        </select>
                    </div>
                    <div class="field span-2">
                        <label for="raw-summary">Summary</label>
                        <input id="raw-summary" type="text" name="summary" value="@Model.Summary" maxlength="@Nergal.Web.PolicyEditorViewModel.MaximumSummaryLength" />
                    </div>
                </div>
                <div class="field">
                    <label for="raw-bundle-json">Bundle JSON</label>
                    <p id="bundle-editor-help" class="muted">JSON syntax highlighting, folding and error markers. Use Ctrl+F (Cmd+F on Mac) to search. Tab moves to the next control. Preview validates policy semantics.</p>
                    <textarea id="raw-bundle-json" class="code-editor" name="bundleJson" data-code-editor="json" data-editor-label="Policy bundle JSON" aria-describedby="bundle-editor-help">@Model.BundleJson</textarea>
                </div>
                <div class="btn-group mt-2">
                    <button type="submit" class="btn btn-secondary">Preview compatibility &amp; nftables diff</button>
                    @if (Model.CanMutate)
                    {
                        <button type="submit" class="btn btn-success" formaction="@Url.Content("~/manage/policies/save")">Save policy revision</button>
                    }
                </div>
            </form>
        </section>

        <section class="card">
            <div class="card-header">
                <h2>Saved policy revisions (@Model.Revisions.Count)</h2>
            </div>
            @if (Model.Revisions.Count == 0)
            {
                <p class="muted mb-0">No policy revisions persisted yet.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Revision</th>
                                <th>Candidate SHA-256</th>
                                <th>Created by</th>
                                <th>Timestamp (local time)</th>
                                <th>Summary</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rev in Model.Revisions)
                            {
                                <tr>
                                    <td><a class="btn btn-secondary btn-sm" href="@Url.Content($"~/manage/policies?revision={rev.Revision}")">Load Rev @rev.Revision</a></td>
                                    <td><code>@rev.CandidateDigest</code></td>
                                    <td><code>@rev.CreatedByActor</code></td>
                                    <td class="mono">@await Html.PartialAsync("_LocalTime", rev.CreatedAtUtc)</td>
                                    <td>@(rev.Summary ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</main>

@section Scripts {
    <script src="@Url.Content("~/js/code-editor.bundle.js")" asp-append-version="true" defer></script>
    <script src="@Url.Content("~/js/policy-draft.js")" asp-append-version="true" defer></script>
}

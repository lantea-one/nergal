@model Nergal.Core.Controller.NativeSourceSnapshot
@inject Microsoft.Extensions.Localization.IStringLocalizer<Nergal.Web.UiStrings> L
@{
    var source = new Nergal.Web.NativePolicySource(Model.Content.Name, Model.Content.Text, Model.Content.Digest);
}
            <p class="muted">@L["Source SHA-256"] <code>@source.Digest</code></p>
            <div class="alert alert-warning">
                <strong>@L["Conversion blocked — explicit mapping required."]</strong>
                @L["Review topics help locate work; they do not validate or convert the configuration. Keywords may be identifiers, so inspect each occurrence in context. No policy has been created or applied."]
            </div>
            @if (source.Review.InventoryComplete)
            {
                <p><strong>@source.Review.TableDeclarations</strong> @L["declarative table headers"] ·
                    <strong>@source.Review.ChainDeclarations</strong> @L["declarative chain headers"] ·
                    <strong>@source.Review.Signals.Count</strong> @L["review topics"]</p>
            }
            @if (!source.Review.InventoryComplete)
            {
                <p class="alert alert-danger" role="alert">@L["Inventory incomplete:"] <code>@source.Review.Diagnostic</code>.
                    @if (source.Analysis.Structure.Summary.Diagnostic is { } diagnostic)
                    { <span>@L["Check line {0}, column {1}.", diagnostic.Span.Line, diagnostic.Span.Column]</span> }
                    @L["Review the exact source below."]</p>
            }
            <details class="disclosure mt-2"><summary>@L["Source structure and diagnostic details"]</summary>
                @if (source.Analysis.Structure.Summary is { IsComplete: true } structure)
                { <p>@L["Source structure is complete: {0} delimiter groups, maximum nesting {1}.", structure.GroupCount, structure.MaximumDepth]</p> }
                else
                { <p>@L["Source structure is incomplete. No partial tree or topic inventory is used."]</p> }
                @if (source.Analysis.RuleParsing is { IsAvailable: true } parsing)
                {
                    <p>@L["{0} of {1} rule statements parsed by the current expression grammar. Parsed rules still require scope, ownership and complete semantic mapping.", parsing.ParsedRules, parsing.TotalRules]</p>
                    @if (parsing.Diagnostics.Count > 0)
                    {
                        <ul>
                        @foreach (var failure in parsing.Diagnostics.Take(20))
                        { <li><code>@failure.Code</code>: @L["line {0}, column {1}. The entire rule remains unmapped.", failure.Span.Line, failure.Span.Column]</li> }
                        </ul>
                        @if (parsing.Diagnostics.Count > 20)
                        { <p>@L["Additional rule diagnostics are available in the review download."]</p> }
                    }
                }
                <p>@L["These checks retain source structure for mapping; they do not validate native rule semantics or resolve includes. Conversion remains blocked."]</p>
            </details>
            @if (source.Review.Signals.Count > 0)
            {
                <div class="table-wrap">
                    <table class="table">
                        <caption>@L["Migration review signals — non-exhaustive, not semantic validation"]</caption>
                        <thead><tr><th scope="col">@L["Review area"]</th><th scope="col">@L["Work to preserve behavior"]</th><th scope="col">@L["Source lines"]</th></tr></thead>
                        <tbody>
                        @foreach (var signal in source.Review.Signals)
                        {
                            <tr>
                                <td>@(signal.Kind == Nergal.Nftables.MigrationSignalKind.ContractGap ? L["Contract gap signal"] : signal.Kind == Nergal.Nftables.MigrationSignalKind.SourceResolution ? L["Source resolution"] : L["Explicit typed mapping"])</td>
                                <td>@L[signal.Description] <br /><small class="muted">@signal.Code</small></td>
                                <td>@string.Join(", ", signal.Lines.Take(12))@(signal.Lines.Count > 12 ? L[" (+{0} more in report)", signal.Lines.Count - 12].Value : "")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else if (source.Review.InventoryComplete)
            {
                <p>@L["No catalogued keywords were found. This does not establish compatibility or completeness."]</p>
            }
            else
            {
                <p>@L["Review topics are unavailable until the source error is resolved."]</p>
            }
            <p>@L["Every table still needs explicit ownership, hook and rule-order mapping. Counters, definitions, named objects and control flow must be accounted for before an equivalent policy can be reviewed."]</p>
            <a class="btn btn-secondary" href="@Url.Action("SourceReview", new { sourceId = Model.Summary.Id })">@L["Download migration review"]</a>
            <details class="disclosure mt-2"><summary>@L["Exact source snapshot"]</summary><pre><code>@source.Text</code></pre></details>


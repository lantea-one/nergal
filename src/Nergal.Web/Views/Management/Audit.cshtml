@model Nergal.Web.AuditHistoryViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Audit & revision history";
    ViewData["ActiveNav"] = "audit";
    ViewData["ActorRole"] = Model.ActorRole;
    ViewData["ShowManageNav"] = true;
}
<main class="container">
    <div class="page-header">
        <div>
            <h1>Controller audit &amp; revision history</h1>
            <p class="page-subtitle">Trigger-protected append-only audit log and immutable policy revision archive.</p>
        </div>
        <span class="badge badge-neutral">@Model.Entries.Count events · @Model.Revisions.Count revisions</span>
    </div>

    <section class="card">
        <div class="card-header">
            <h2>Append-only audit log (@Model.Entries.Count)</h2>
            <div style="min-width: 240px;">
                <input type="text" placeholder="Filter by actor, action, target, outcome…" data-audit-filter aria-label="Filter audit entries" />
            </div>
        </div>

        @if (Model.Entries.Count == 0)
        {
            <p class="muted mb-0">No audit events recorded.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Seq</th>
                            <th>UTC Timestamp</th>
                            <th>Actor</th>
                            <th>Role</th>
                            <th>Action</th>
                            <th>Target</th>
                            <th>Rev</th>
                            <th>Outcome</th>
                            <th>Detail</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Entries)
                        {
                            var badge = entry.Outcome is "confirmed" or "saved" or "registered" or "matched"
                                ? "badge-success"
                                : entry.Outcome is "rejected" or "failed" or "denied"
                                    ? "badge-danger"
                                    : "badge-warning";
                            <tr data-audit-row>
                                <td>#@entry.Sequence</td>
                                <td class="mono">@entry.TimestampUtc.ToString("u")</td>
                                <td><code>@entry.ActorId</code></td>
                                <td><span class="badge badge-neutral">@entry.ActorRole</span></td>
                                <td><code>@entry.Action</code></td>
                                <td><code>@entry.Target</code></td>
                                <td>@(entry.Revision?.ToString() ?? "—")</td>
                                <td><span class="badge @badge">@entry.Outcome</span></td>
                                <td><code>@(entry.DetailCode ?? "—")</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card">
        <div class="card-header">
            <h2>Saved policy revisions (@Model.Revisions.Count)</h2>
            <a class="btn btn-secondary btn-sm" href="@Url.Content("~/manage/policies")">Open Policy Builder</a>
        </div>
        @if (Model.Revisions.Count == 0)
        {
            <p class="muted mb-0">No saved policy revisions.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Revision</th>
                            <th>Candidate SHA-256</th>
                            <th>Created by</th>
                            <th>Created UTC</th>
                            <th>Summary</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rev in Model.Revisions)
                        {
                            <tr>
                                <td><a class="btn btn-secondary btn-sm" href="@Url.Content($"~/manage/policies?revision={rev.Revision}")">Rev @rev.Revision</a></td>
                                <td><code>@rev.CandidateDigest</code></td>
                                <td><code>@rev.CreatedByActor</code></td>
                                <td class="mono">@rev.CreatedAtUtc.ToString("u")</td>
                                <td>@(rev.Summary ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>

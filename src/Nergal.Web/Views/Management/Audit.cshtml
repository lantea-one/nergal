@model Nergal.Web.AuditHistoryViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Nergal.Web.UiStrings> L
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Audit & revision history";
    ViewData["ActiveNav"] = "audit";
    ViewData["ActorRole"] = Model.ActorRole;
    ViewData["ShowManageNav"] = true;
    ViewData["LocalizedContent"] = true;
    var displayCulture = System.Globalization.CultureInfo.CurrentUICulture;
    var entryCount = Model.Entries.Count.ToString("N0", displayCulture);
    var revisionCount = Model.Revisions.Count.ToString("N0", displayCulture);
}
<main id="main-content" tabindex="-1" class="container">
    <div class="page-header">
        <div>
            <h1>@L["Controller audit & revision history"]</h1>
            <p class="page-subtitle">@L["Trigger-protected append-only audit log and immutable policy revision archive."]</p>
        </div>
        <span class="badge badge-neutral">@L["Events: {0} · Revisions: {1}", entryCount, revisionCount]</span>
    </div>

    <section class="card">
        <div class="card-header">
            <h2>@L["Append-only audit log ({0})", entryCount]</h2>
            <div style="min-width: 240px;">
                <input type="text" placeholder="@L["Filter by actor, action, target, outcome…"]" data-audit-filter aria-label="@L["Filter audit entries"]" />
            </div>
        </div>

        @if (Model.Entries.Count == 0)
        {
            <p class="muted mb-0">@L["No audit events recorded."]</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>@L["Seq"]</th>
                            <th>@L["Timestamp (local time)"]</th>
                            <th>@L["Actor"]</th>
                            <th>@L["Role"]</th>
                            <th>@L["Action"]</th>
                            <th>@L["Target"]</th>
                            <th>@L["Rev"]</th>
                            <th>@L["Outcome"]</th>
                            <th>@L["Detail"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Entries)
                        {
                            var badge = entry.Outcome is "confirmed" or "saved" or "registered" or "matched"
                                ? "badge-success"
                                : entry.Outcome is "rejected" or "failed" or "denied"
                                    ? "badge-danger"
                                    : "badge-warning";
                            <tr data-audit-row>
                                <td>#@entry.Sequence</td>
                                <td class="mono">@await Html.PartialAsync("_LocalTime", entry.TimestampUtc)</td>
                                <td><code>@entry.ActorId</code></td>
                                <td><span class="badge badge-neutral">@entry.ActorRole</span></td>
                                <td><code>@entry.Action</code></td>
                                <td><code>@entry.Target</code></td>
                                <td>@(entry.Revision?.ToString() ?? "—")</td>
                                <td><span class="badge @badge">@entry.Outcome</span></td>
                                <td><code>@(entry.DetailCode ?? "—")</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card">
        <div class="card-header">
            <h2>@L["Saved policy revisions ({0})", revisionCount]</h2>
            <a class="btn btn-secondary btn-sm" href="@Url.Content("~/manage/policies")">@L["Open Policy Builder"]</a>
        </div>
        @if (Model.Revisions.Count == 0)
        {
            <p class="muted mb-0">@L["No saved policy revisions."]</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>@L["Revision"]</th>
                            <th>@L["Candidate SHA-256"]</th>
                            <th>@L["Created by"]</th>
                            <th>@L["Created (local time)"]</th>
                            <th>@L["Summary"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rev in Model.Revisions)
                        {
                            <tr>
                                <td><a class="btn btn-secondary btn-sm" href="@Url.Content($"~/manage/policies?revision={rev.Revision}")">@L["Rev {0}", rev.Revision]</a></td>
                                <td><code>@rev.CandidateDigest</code></td>
                                <td><code>@rev.CreatedByActor</code></td>
                                <td class="mono">@await Html.PartialAsync("_LocalTime", rev.CreatedAtUtc)</td>
                                <td>@(rev.Summary ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>

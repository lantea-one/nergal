@model Nergal.Web.RawRuleFormModel
@using Nergal.Core.Policy
@{
    var r = Model.Index is { } index ? Model.Editor.Bundle!.Filter.RpFilter!.Rules[index] : null;
    var prefix = "raw-" + (Model.Index?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "new");
}
<form class="router-form" method="post" action="@Url.Content("~/manage/policies/raw/rule")" aria-describedby="@(prefix)-hint">
    @Html.AntiForgeryToken()
    <input type="hidden" name="bundleJson" value="@Model.Editor.BundleJson" />
    <input type="hidden" name="summary" value="@Model.Editor.Summary" />
    <input type="hidden" name="compareToRevision" value="@Model.Editor.CompareToRevision" />
    <input type="hidden" name="operation" value="@(Model.Index is null ? "add" : "edit")" />
    @if (Model.Index is not null) { <input type="hidden" name="ruleIndex" value="@Model.Index" /> }
    <p id="@(prefix)-hint" class="hint">Raw prerouting runs before connection tracking. Rules run in order; put intentional exceptions before a reverse-path drop. This form changes only the draft, retaining an existing rule's enabled state.</p>
    @if (r?.CountPackets == true) { <p class="hint">This rule counts matching packets and bytes before its verdict.</p> }
    @if (r?.BindInputInterfaceIndex == true) { <p class="hint">Installation binds the input name to its interface index.</p> }
    @if (r?.Destination is not null || r?.DestinationPrefixes is not null)
    {
        <p class="hint">Destination restriction: @(r.Destination?.Value ?? string.Join(", ", r.DestinationPrefixes!.Select(p => p.Value))). Edit this restriction in Advanced JSON.</p>
    }
    <div class="form-grid">
        <div class="field"><label for="@(prefix)-family">IP family</label><select id="@(prefix)-family" name="family"><option value="any" selected="@(r?.Family is null)">IPv4 and IPv6</option><option value="ipv4" selected="@(r?.Family == IpFamily.IPv4)">IPv4</option><option value="ipv6" selected="@(r?.Family == IpFamily.IPv6)">IPv6</option></select></div>
        <div class="field"><label for="@(prefix)-verdict">Raw action</label><select id="@(prefix)-verdict" name="verdict"><option value="accept" selected="@(r is null || r.Verdict == FilterVerdict.Accept)">Accept — continue to later hooks</option><option value="drop" selected="@(r?.Verdict == FilterVerdict.Drop)">Drop</option><option value="notrack" selected="@(r?.Notrack == true)">Disable connection tracking and continue</option></select></div>
        <div class="field"><label for="@(prefix)-protocol">Protocol</label><select id="@(prefix)-protocol" name="protocol"><option value="any" selected="@(r is null || r.Protocol == FilterProtocol.Any)">Any</option><option value="tcp" selected="@(r?.Protocol == FilterProtocol.Tcp)">TCP</option><option value="udp" selected="@(r?.Protocol == FilterProtocol.Udp)">UDP</option></select></div>
        <div class="field"><label for="@(prefix)-source">Source CIDR (optional)</label><input type="text" id="@(prefix)-source" name="@(r?.SourcePrefixes is null ? "source" : null)" readonly="@(r?.SourcePrefixes is not null)" value="@(r?.SourcePrefixes is { } sources ? string.Join(", ", sources.Select(p => p.Value)) : r?.Source?.Value)" aria-describedby="@(prefix)-source-hint" /><span id="@(prefix)-source-hint" class="hint">Choose a single IP family for a source restriction. Edit source sets in Advanced JSON.</span><label class="checkbox-row"><input type="checkbox" name="negateSource" value="true" checked="@(r?.NegateSource == true)" /> Except this source</label></div>
        <div class="field"><label for="@(prefix)-input">Input interface (optional)</label><input type="text" id="@(prefix)-input" name="inputInterface" value="@r?.InputInterface" maxlength="15" /><label class="checkbox-row"><input type="checkbox" name="negateInputInterface" value="true" checked="@(r?.NegateInputInterface == true)" /> Except this input interface</label></div>
        <div class="field"><label for="@(prefix)-sport">Source port (optional)</label><input type="number" id="@(prefix)-sport" name="sourcePort" value="@r?.SourcePort" min="1" max="65535" aria-describedby="@(prefix)-port-hint" /><span id="@(prefix)-port-hint" class="hint">Ports require TCP or UDP. For a DHCP-client exception, choose UDP source port 68 and review its scope.</span></div>
        <div class="field"><label for="@(prefix)-dport">Destination port (optional)</label><input type="number" id="@(prefix)-dport" name="destinationPort" value="@r?.DestinationPort" min="1" max="65535" /></div>
        <div class="field"><label class="checkbox-row"><input type="checkbox" name="matchFibUnreachable" value="true" checked="@(r?.MatchFibUnreachable == true)" /> Match failed reverse-path lookup</label><span class="hint">Matches <code>fib saddr . iif oif == 0</code>: no reverse route through the input interface. With Drop, this rejects packets failing the lookup.</span></div>
        <div class="field span-2"><label for="@(prefix)-description">Description (optional)</label><input type="text" id="@(prefix)-description" name="description" value="@r?.Description" maxlength="160" /></div>
    </div>
    <button type="submit" class="btn btn-sm">@(Model.Index is null ? "Add raw rule to draft" : "Update raw rule draft")</button>
</form>

@model Nergal.Web.ConfirmedApplyViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Confirmed apply";
    ViewData["ActiveNav"] = "apply";
    ViewData["ActorRole"] = Model.ActorRole;
    ViewData["ShowManageNav"] = true;
}
<main class="container">
    <div class="page-header">
        <div>
            <h1>Two-phase confirmed apply</h1>
            <p class="page-subtitle">Dispatch compiled multi-table bundles with an autonomous local watchdog rollback window.</p>
        </div>
        <a class="btn btn-secondary" href="@Url.Content("~/manage/policies")">Edit Policy Bundles</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.Hosts.Count == 0)
    {
        <section class="card">
            <h2>Target host</h2>
            <p class="muted">No managed hosts registered yet. Register a host from the <a href="@Url.Content("~/manage")">fleet dashboard</a> before dispatching an apply.</p>
        </section>
    }
    else
    {
        <section class="card">
            <div class="card-header">
                <h2>1. Target host selection</h2>
            </div>
            <form method="get" action="@Url.Content("~/manage/apply")" class="form-grid">
                <div class="field span-2">
                    <label for="apply-host-select">Enrolled host</label>
                    <select id="apply-host-select" name="hostId">
                        @foreach (var host in Model.Hosts)
                        {
                            <option value="@host.Id.ToString("D")" selected="@(Model.SelectedHost?.Id == host.Id)">@host.Name (@host.TransportKind — rev @host.LastKnownRevision)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <button type="submit" class="btn btn-secondary">Refresh live status</button>
                </div>
            </form>
        </section>

        @if (Model.SelectedHost is { } selectedHost)
        {
            var outcomeStr = Model.LiveReply is { } lr ? Nergal.Web.ControllerStateHost.FormatOutcome(lr.Outcome) : "unknown";
            var outcomeBadge = outcomeStr is "matched" or "confirmed"
                ? "badge-success"
                : outcomeStr is "appliedPendingConfirmation" or "busy"
                    ? "badge-warning"
                    : "badge-danger";

            <section class="card">
                <div class="card-header">
                    <div>
                        <h2>2. Live agent status — <code>@selectedHost.Name</code></h2>
                        <p class="muted mb-0" style="font-size: 0.86rem;">
                            Transport <code>@selectedHost.TransportKind</code> at <code>@selectedHost.Endpoint</code> · Controller revision <code>@selectedHost.LastKnownRevision</code>
                        </p>
                    </div>
                    <span class="badge @outcomeBadge">@outcomeStr</span>
                </div>

                @if (Model.LiveReply is { } reply)
                {
                    <dl class="meta-grid">
                        <div class="meta-item">
                            <dt>Outcome</dt>
                            <dd><code>@outcomeStr</code></dd>
                        </div>
                        @if (reply.Revision is { } agentRev)
                        {
                            <div class="meta-item">
                                <dt>Agent baseline revision</dt>
                                <dd><code>@agentRev</code></dd>
                            </div>
                        }
                        @if (reply.ActivePhase is { } phase)
                        {
                            <div class="meta-item">
                                <dt>Active phase</dt>
                                <dd><code>@Nergal.Web.ControllerStateHost.FormatPhase(phase)</code></dd>
                            </div>
                        }
                        @if (reply.RemainingSeconds is { } rem)
                        {
                            <div class="meta-item">
                                <dt>Watchdog countdown</dt>
                                <dd><code data-countdown-seconds="@rem">@rem s remaining</code></dd>
                            </div>
                        }
                        @if (reply.OperationId is { } opId)
                        {
                            <div class="meta-item">
                                <dt>Operation ID</dt>
                                <dd><code>@opId.ToString("D")</code></dd>
                            </div>
                        }
                        @if (reply.WatchdogId is { } wdId)
                        {
                            <div class="meta-item">
                                <dt>Watchdog ID</dt>
                                <dd><code>@wdId.ToString("D")</code></dd>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(reply.CandidateDigest))
                        {
                            <div class="meta-item">
                                <dt>Candidate SHA-256</dt>
                                <dd><code>@reply.CandidateDigest</code></dd>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(reply.ErrorCode))
                        {
                            <div class="meta-item">
                                <dt>Detail</dt>
                                <dd><code>@reply.ErrorCode</code></dd>
                            </div>
                        }
                    </dl>
                }
            </section>

            @if (Model.CanMutate)
            {
                @if (Model.LiveReply?.OperationId is { } pendingOp &&
                     Model.LiveReply?.WatchdogId is { } pendingWd &&
                     Model.LiveReply.ActivePhase == Nergal.Core.Deployment.ApplyPhase.AwaitingConfirmation)
                {
                    <section class="card" style="border-color: var(--warning);">
                        <div class="card-header">
                            <h2>3. Pending confirmation window</h2>
                            <span class="badge badge-warning">Watchdog armed</span>
                        </div>
                        <p class="muted">
                            The candidate ruleset is active on <code>@selectedHost.Name</code>. Confirm now to make it permanent, or roll back immediately. If connectivity is lost, the local watchdog will automatically restore the previous baseline.
                        </p>
                        <div class="countdown-bar" aria-hidden="true">
                            <div class="countdown-fill" data-countdown-fill style="width: 100%;"></div>
                        </div>
                        <div class="btn-group">
                            <form class="inline-form" method="post" action="@Url.Content("~/manage/apply/confirm")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="hostId" value="@selectedHost.Id.ToString("D")" />
                                <input type="hidden" name="operationId" value="@pendingOp.ToString("D")" />
                                <input type="hidden" name="watchdogId" value="@pendingWd.ToString("D")" />
                                @if (Model.SelectedRevision is { } selRev)
                                {
                                    <input type="hidden" name="targetRevision" value="@selRev" />
                                }
                                <button type="submit" class="btn btn-success">Confirm active apply</button>
                            </form>
                            <form class="inline-form" method="post" action="@Url.Content("~/manage/apply/rollback")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="hostId" value="@selectedHost.Id.ToString("D")" />
                                <input type="hidden" name="operationId" value="@pendingOp.ToString("D")" />
                                <input type="hidden" name="watchdogId" value="@pendingWd.ToString("D")" />
                                @if (Model.SelectedRevision is { } rbRev)
                                {
                                    <input type="hidden" name="targetRevision" value="@rbRev" />
                                }
                                <button type="submit" class="btn btn-danger">Immediate rollback</button>
                            </form>
                        </div>
                    </section>
                }
                else if (Model.Revisions.Count > 0)
                {
                    <section class="card">
                        <div class="card-header">
                            <h2>3. Start confirmed apply</h2>
                            <span class="badge badge-primary">Two-phase safe apply</span>
                        </div>
                        <form method="post" action="@Url.Content("~/manage/apply/start")">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="hostId" value="@selectedHost.Id.ToString("D")" />
                            <div class="form-grid">
                                <div class="field span-2">
                                    <label for="apply-revision">Policy revision</label>
                                    <select id="apply-revision" name="revision">
                                        @foreach (var rev in Model.Revisions)
                                        {
                                            <option value="@rev.Revision" selected="@(Model.SelectedRevision == rev.Revision)">
                                                Revision @rev.Revision (@rev.CandidateDigest[..8])@(string.IsNullOrWhiteSpace(rev.Summary) ? "" : " — " + rev.Summary)
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="field">
                                    <label for="apply-timeout">Confirmation timeout (1–3600s)</label>
                                    <input id="apply-timeout" type="number" name="confirmationTimeoutSeconds" min="1" max="3600" value="30" required />
                                </div>
                            </div>
                            <div class="mt-2">
                                <button type="submit">Start confirmed apply</button>
                            </div>
                        </form>
                    </section>
                }
                else
                {
                    <section class="card">
                        <h2>3. Start confirmed apply</h2>
                        <p class="muted mb-0">No saved policy revisions exist yet. Create and save a policy revision in the <a href="@Url.Content("~/manage/policies")">policy editor</a> before applying.</p>
                    </section>
                }
            }
        }
    }

    <section class="card">
        <div class="card-header">
            <h2>Recent apply &amp; controller audit activity</h2>
            <a class="btn btn-secondary btn-sm" href="@Url.Content("~/manage/audit")">View full log</a>
        </div>
        @if (Model.RecentAudit.Count == 0)
        {
            <p class="muted mb-0">No audit records yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Seq</th>
                            <th>Timestamp (UTC)</th>
                            <th>Actor</th>
                            <th>Action</th>
                            <th>Target</th>
                            <th>Outcome</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.RecentAudit)
                        {
                            var badge = entry.Outcome is "confirmed" or "saved" or "registered"
                                ? "badge-success"
                                : entry.Outcome is "rejected" or "failed"
                                    ? "badge-danger"
                                    : "badge-warning";
                            <tr>
                                <td>#@entry.Sequence</td>
                                <td class="mono">@entry.TimestampUtc.ToString("u")</td>
                                <td><code>@entry.ActorId</code></td>
                                <td><code>@entry.Action</code></td>
                                <td><code>@entry.Target</code></td>
                                <td><span class="badge @badge">@entry.Outcome</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>

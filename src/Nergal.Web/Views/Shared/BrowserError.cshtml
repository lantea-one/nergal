@model Nergal.Web.BrowserErrorModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Nergal.Web.UiStrings> L
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Title;
    ViewData["LocalizedContent"] = true;
}
<main id="main-content" tabindex="-1" class="container-narrow">
    <section class="card" aria-labelledby="error-heading">
        <p class="eyebrow">@L["Request {0}", Model.Status]</p>
        <h1 id="error-heading">@L[Model.Title]</h1>
        <p>@L[Model.Message]</p>
        <a class="btn" href="@Url.Content("~" + Model.ActionPath)">@L[Model.ActionText]</a>
    </section>
</main>

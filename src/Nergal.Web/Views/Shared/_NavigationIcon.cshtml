@model string
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider Files
@{
    var href = Files.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/icons/navigation.svg")) + "#" + Model;
}
<svg class="nav-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24"><use href="@href"></use></svg>

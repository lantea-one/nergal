@addTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.ScriptTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.LinkTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var branding = ViewData["Branding"] as Nergal.Core.Controller.BrandingSettings ?? Nergal.Core.Controller.SystemSettingsSnapshot.Default.Branding;
    var appName = string.IsNullOrWhiteSpace(branding.ApplicationName) ? "nergal" : branding.ApplicationName;
    var title = ViewData["Title"] as string ?? appName;
    var activeNav = ViewData["ActiveNav"] as string ?? "";
    var actorRole = ViewData["ActorRole"] as string;
    var showNav = ViewData["ShowManageNav"] as bool? ?? false;
}
<!doctype html>
<html lang="en" data-accent="@branding.AccentColor" data-default-theme="@branding.DefaultTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title · @appName</title>
    <link rel="icon" type="image/png" sizes="1254x1254" href="@Url.Content("~/brand/guardian.png")" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="@Url.Content("~/brand/guardian.svg")" asp-append-version="true" />
    <script src="@Url.Content("~/js/theme.js")" asp-append-version="true"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/nergal.css")" asp-append-version="true" />
</head>
<body class="@(showNav ? "management-shell" : "")">
    @if (showNav) { <a class="skip-link" href="#main-content">Skip to content</a> }
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="@Url.Content(showNav ? "~/manage" : "~/")">
                <span class="guardian-mark" aria-hidden="true"></span>
                <span>@appName</span>
            </a>

            @if (showNav)
            { <button type="button" class="btn btn-secondary btn-sm navigation-toggle" data-sidebar-toggle aria-controls="management-navigation" aria-expanded="false">Menu</button> }

            <div class="topbar-meta">
                @if (!string.IsNullOrEmpty(actorRole))
                {
                    <span class="badge @(actorRole == Nergal.Core.Identity.NergalRoles.Administrator ? "badge-primary" : "badge-neutral")">@(actorRole == Nergal.Core.Identity.NergalRoles.Administrator ? "Administrator" : "Auditor")</span>
                }
                <button type="button" class="btn btn-secondary btn-sm" data-theme-toggle>Theme</button>
            </div>
        </div>
    </header>

    @if (showNav)
    {
        <div class="appliance-shell">
            <aside class="appliance-sidebar" id="management-navigation">
                @await Html.PartialAsync("_ManagementNavigation")
            </aside>
            <div class="appliance-content">@RenderBody()</div>
        </div>
    }
    else { @RenderBody() }

    <footer class="time-zone-note muted @(ViewData["CenterFooter"] is true ? "time-zone-note-centered" : "")">Nergal Firewall Management - TZ: <span data-local-time-zone>UTC (local time unavailable)</span></footer>
    <script src="@Url.Content("~/js/local-time.js")" asp-append-version="true" defer></script>
    <script src="@Url.Content("~/js/nergal.js")" asp-append-version="true" defer></script>
    @if (showNav) { <script src="@Url.Content("~/js/navigation.js")" asp-append-version="true" defer></script> }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

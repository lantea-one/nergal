@addTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.ScriptTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.LinkTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Http
@inject Microsoft.Extensions.Localization.IStringLocalizer<Nergal.Web.UiStrings> L
@{
    var branding = ViewData["Branding"] as Nergal.Core.Controller.BrandingSettings ?? Nergal.Core.Controller.SystemSettingsSnapshot.Default.Branding;
    var appName = string.IsNullOrWhiteSpace(branding.ApplicationName) ? "nergal" : branding.ApplicationName;
    var title = ViewData["Title"] is string pageTitle ? L[pageTitle] : null;
    var actorRole = ViewData["ActorRole"] as string;
    var showNav = ViewData["ShowManageNav"] as bool? ?? false;
    var locale = System.Globalization.CultureInfo.CurrentUICulture;
    var culture = locale.Name;
    var english = Nergal.Web.UiLocalization.DefaultCulture.Name;
    var bodyLanguage = Nergal.Web.UiLocalization.HasLocalizedBody(locale, ViewData["LocalizedContent"] is true) ? null : english;
    var direction = locale.TextInfo.IsRightToLeft ? "rtl" : "ltr";
    Context.Response.Headers.ContentLanguage = culture;
    Context.Response.Headers.Append("Vary", "Cookie");
}
<!doctype html>
<html lang="@culture" dir="@direction" data-ui-locale="@culture" data-accent="@branding.AccentColor" data-default-theme="@branding.DefaultTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title lang="@(title?.ResourceNotFound == true && culture != english ? english : null)">@(title?.Value ?? appName) · @appName</title>
    <link rel="icon" type="image/png" sizes="1254x1254" href="@Url.Content("~/brand/guardian.png")" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="@Url.Content("~/brand/guardian.svg")" asp-append-version="true" />
    <script src="@Url.Content("~/js/theme.js")" asp-append-version="true"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/nergal.css")" asp-append-version="true" />
</head>
<body class="@(showNav ? "management-shell" : "")">
    <a class="skip-link" href="#main-content">@L["Skip to content"]</a>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="@Url.Content(showNav ? "~/manage" : "~/")">
                <span class="guardian-mark" aria-hidden="true"></span>
                <span>@appName</span>
            </a>

            @if (showNav)
            { <button type="button" class="btn btn-secondary btn-sm navigation-toggle" data-sidebar-toggle aria-controls="management-navigation" aria-expanded="false">@L["Menu"]</button> }

            <div class="topbar-meta">
                @if (ViewData["UserDisplayName"] is string displayName)
                { <a class="nav-link profile-link" href="@Url.Content("~/profile")" aria-label="@L["My profile for {0}", displayName]">@displayName</a> }
                @if (!string.IsNullOrEmpty(actorRole))
                {
                    <span class="badge @(actorRole == Nergal.Core.Identity.NergalRoles.Administrator ? "badge-primary" : "badge-neutral")">@L[actorRole == Nergal.Core.Identity.NergalRoles.Administrator ? "Administrator" : "Auditor"]</span>
                }
                @await Html.PartialAsync("_LanguageMenu")
                <button type="button" class="btn btn-secondary btn-sm" data-theme-toggle
                        data-light-label="@L["Light mode"]" data-light-action="@L["Switch to light theme"]"
                        data-dark-label="@L["Dark mode"]" data-dark-action="@L["Switch to dark theme"]">@L["Theme"]</button>
            </div>
        </div>
    </header>

    @if (showNav)
    {
        <div class="appliance-shell">
            <aside class="appliance-sidebar" id="management-navigation">
                @await Html.PartialAsync("_ManagementNavigation")
            </aside>
            <div class="appliance-content" lang="@bodyLanguage" dir="@(bodyLanguage is null ? null : "ltr")">@RenderBody()</div>
        </div>
    }
    else if (bodyLanguage is not null) { <div lang="@bodyLanguage" dir="ltr">@RenderBody()</div> }
    else { @RenderBody() }

    <script src="@Url.Content("~/js/local-time.js")" asp-append-version="true" defer></script>
    <script src="@Url.Content("~/js/nergal.js")" asp-append-version="true" defer></script>
    @if (showNav) { <script src="@Url.Content("~/js/navigation.js")" asp-append-version="true" defer></script> }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

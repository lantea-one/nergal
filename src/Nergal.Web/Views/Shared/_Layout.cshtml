@{
    var branding = ViewData["Branding"] as Nergal.Core.Controller.BrandingSettings ?? Nergal.Core.Controller.SystemSettingsSnapshot.Default.Branding;
    var appName = string.IsNullOrWhiteSpace(branding.ApplicationName) ? "nergal" : branding.ApplicationName;
    var brandMark = char.ToUpperInvariant(appName[0]);
    var title = ViewData["Title"] as string ?? appName;
    var activeNav = ViewData["ActiveNav"] as string ?? "";
    var actorRole = ViewData["ActorRole"] as string;
    var showNav = ViewData["ShowManageNav"] as bool? ?? false;
}
<!doctype html>
<html lang="en" data-accent="@branding.AccentColor" data-default-theme="@branding.DefaultTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title · @appName</title>
    <script src="@Url.Content("~/js/theme.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/nergal.css")" />
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="@Url.Content(showNav ? "~/manage" : "~/")">
                <span class="brand-mark" aria-hidden="true">@brandMark</span>
                <span>@appName</span>
            </a>

            @if (showNav)
            {
                <nav class="nav-links" aria-label="Primary navigation">
                    <a class="nav-link @(activeNav == "fleet" ? "active" : "")" href="@Url.Content("~/manage")">Dashboard</a>
                    <a class="nav-link @(activeNav == "policies" ? "active" : "")" href="@Url.Content("~/manage/policies")">Policies</a>
                    <a class="nav-link @(activeNav == "apply" ? "active" : "")" href="@Url.Content("~/manage/apply")">Confirmed Apply</a>
                    <a class="nav-link @(activeNav == "audit" ? "active" : "")" href="@Url.Content("~/manage/audit")">Audit</a>
                    <a class="nav-link @(activeNav == "settings" ? "active" : "")" href="@Url.Content("~/manage/settings")">Settings</a>
                    @if (ViewData["ShowNativeSources"] as bool? == true)
                    {
                        <a class="nav-link @(activeNav == "sources" ? "active" : "")" href="@Url.Content("~/manage/sources")">Native sources</a>
                    }
                    <a class="nav-link @(activeNav == "session" ? "active" : "")" href="@Url.Content("~/session")">Session</a>
                </nav>
            }

            <div class="topbar-meta">
                @if (!string.IsNullOrEmpty(actorRole))
                {
                    <span class="badge @(actorRole == Nergal.Core.Identity.NergalRoles.Administrator ? "badge-primary" : "badge-neutral")">@(actorRole == Nergal.Core.Identity.NergalRoles.Administrator ? "Administrator" : "Auditor")</span>
                }
                <button type="button" class="btn btn-secondary btn-sm" data-theme-toggle>Theme</button>
            </div>
        </div>
    </header>

    @RenderBody()

    <script src="@Url.Content("~/js/nergal.js")" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

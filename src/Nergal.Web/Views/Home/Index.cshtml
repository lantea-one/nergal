@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>nergal</title></head>
<body>
  <main>
    <h1>nergal</h1>
    <p>Self-hosted Linux firewall management. Early development foundation.</p>
    <p>The first backend uses native nftables. Local administrators can read agent status when a connection is configured.</p>
    @if (Url.RouteUrl("local-login", new { controller = "Session", action = "Login" }) is string loginUrl)
    {
        <p><a href="@loginUrl">Administrator login</a></p>
    }
    <p><a href="/backend-decision">Read the backend decision</a></p>
  </main>
</body>
</html>

@inject Microsoft.Extensions.Localization.IStringLocalizer<Nergal.Web.UiStrings> L
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["LocalizedForAllLanguages"] = true;
    ViewData["Title"] = "Recovery could not start";
}
<main id="main-content" tabindex="-1" class="container-narrow">
    <h1>@L["Recovery could not start"]</h1>
    <p>@L["Check your authorization and credentials. If the authorization has expired or setup already started, ask for a new authorization."]</p>
    <a href="@Url.Content("~/login/recovery")">@L["Return to authenticator recovery"]</a>
</main>

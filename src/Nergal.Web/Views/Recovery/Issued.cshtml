@model Nergal.Identity.RecoveryAuthorization
@inject Microsoft.Extensions.Localization.IStringLocalizer<Nergal.Web.UiStrings> L
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Recovery authorization";
}
<main id="main-content" tabindex="-1" class="container-narrow">
    <h1>@L["Recovery authorization"]</h1>
    <section class="card">
        <p>@L["Give this one-time authorization to the verified recipient through a private channel. It expires in ten minutes."]</p>
        <p><code class="text-break">@Model.Authorization</code></p>
        <p>@L["Ask the recipient to open"] <a href="@Url.Content("~/login/recovery")">@L["authenticator recovery"]</a> @L["and use their current password. The setup key appears once after verification."]</p>
        <a class="btn btn-secondary" href="@Url.Content("~/manage/identity/mfa")">@L["Back to MFA policy"]</a>
    </section>
</main>

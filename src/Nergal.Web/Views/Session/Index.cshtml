@inject Microsoft.Extensions.Localization.IStringLocalizer<Nergal.Web.UiStrings> L
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Administrator session";
    ViewData["ActiveNav"] = "session";
    ViewData["ShowManageNav"] = Url.RouteUrl("manage-dashboard") is not null;
}
<main id="main-content" tabindex="-1" class="container-narrow">
    <div class="card" style="padding: 1.75rem;">
        <div class="card-header">
            <h1 style="margin: 0; font-size: 1.45rem;">@L["Administrator session"]</h1>
            <span class="badge badge-success">@L["Authenticated"]</span>
        </div>

        <p class="muted">@L["Signed in as"] <strong>@User.Identity?.Name</strong>.</p>
        <p><a href="@Url.Content("~/profile")">@L["My profile"]</a></p>

        <div class="btn-group mt-2" style="margin-bottom: 1.25rem;">
            @if (Url.RouteUrl("manage-dashboard") is string manageUrl)
            {
                <a class="btn" href="@manageUrl">@L["Manage fleet, policies & audit"]</a>
            }
            @if (Url.RouteUrl("local-agent-status") is string statusUrl)
            {
                <a class="btn btn-secondary" href="@statusUrl">@L["View agent status"]</a>
            }
        </div>

        <hr style="border: 0; border-top: 1px solid var(--border); margin: 1.25rem 0;" />

        <form method="post" action="@Url.Content("~/logout")">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">@((User.Identity?.AuthenticationType is Nergal.Web.FederatedLogin.Session or Nergal.Web.FederatedLogin.LdapSession) ? L["Sign out of this session"] : L["Sign out of all local sessions"])</button>
        </form>
    </div>
</main>

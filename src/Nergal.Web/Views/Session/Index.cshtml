<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Administrator session · nergal</title></head>
<body>
<main>
    <h1>Administrator session</h1>
    <p>Signed in as @User.Identity?.Name.</p>
    @if (Url.RouteUrl("local-agent-status") is string statusUrl)
    {
        <p><a href="@statusUrl">View agent status</a></p>
    }
    @if (Url.RouteUrl("manage-dashboard") is string manageUrl)
    {
        <p><a href="@manageUrl">Manage fleet, policies &amp; audit</a></p>
    }
    <form method="post" action="@Url.Content("~/logout")">
        @Html.AntiForgeryToken()
        <button type="submit">@(User.Identity?.AuthenticationType == Nergal.Web.FederatedLogin.Session ? "Sign out of this session" : "Sign out of all local sessions")</button>
    </form>
</main>
</body>
</html>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Administrator session";
    ViewData["ActiveNav"] = "session";
    ViewData["ShowManageNav"] = Url.RouteUrl("manage-dashboard") is not null;
}
<main class="container-narrow">
    <div class="card" style="padding: 1.75rem;">
        <div class="card-header">
            <h1 style="margin: 0; font-size: 1.45rem;">Administrator session</h1>
            <span class="badge badge-success">Authenticated</span>
        </div>

        <p class="muted">Signed in as <strong>@User.Identity?.Name</strong>.</p>

        <div class="btn-group mt-2" style="margin-bottom: 1.25rem;">
            @if (Url.RouteUrl("manage-dashboard") is string manageUrl)
            {
                <a class="btn" href="@manageUrl">Manage fleet, policies &amp; audit</a>
            }
            @if (Url.RouteUrl("local-agent-status") is string statusUrl)
            {
                <a class="btn btn-secondary" href="@statusUrl">View agent status</a>
            }
        </div>

        <hr style="border: 0; border-top: 1px solid var(--border); margin: 1.25rem 0;" />

        <form method="post" action="@Url.Content("~/logout")">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">@(User.Identity?.AuthenticationType == Nergal.Web.FederatedLogin.Session ? "Sign out of this session" : "Sign out of all local sessions")</button>
        </form>
    </div>
</main>

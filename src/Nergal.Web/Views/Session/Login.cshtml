@model bool?
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Sign in";
}
<main id="main-content" tabindex="-1" class="container-narrow">
    <div class="sign-in-brand">
        <span class="guardian-mark" role="img" aria-label="Nergal Guardian logo"></span>
        <span class="sign-in-wordmark">Nergal</span>
    </div>
    <div class="card" style="padding: 1.75rem;">
        <h1 style="margin: 0 0 0.25rem; font-size: 1.5rem;">Sign in</h1>
        <p class="muted" style="margin: 0 0 1.25rem;">Sign in to manage enrolled firewall hosts, policy revisions, and confirmed applies.</p>

        @if (Model == false)
        {
            <div class="alert alert-danger" role="alert">Sign-in failed. Verify your credentials and try again.</div>
        }

        <form class="form-stack" method="post" action="@Url.Content("~/login")">
            @Html.AntiForgeryToken()
            <div class="field">
                <label for="login-username">Username</label>
                <input id="login-username" name="username" type="text" autocomplete="username" maxlength="64" required autofocus />
            </div>
            <div class="field">
                <label for="login-password">Password</label>
                <input id="login-password" name="password" type="password" autocomplete="current-password" maxlength="256" required />
            </div>
            <button type="submit" style="width: 100%;">Sign in</button>
        </form>

        @if (Url.RouteUrl("federated-login", new { controller = "Session", action = "Federated" }) is string federatedUrl)
        {
            <hr style="border: 0; border-top: 1px solid var(--border); margin: 1.25rem 0;" />
            <form method="post" action="@federatedUrl">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-secondary" style="width: 100%;">Sign in with identity provider</button>
            </form>
        }
    </div>
</main>

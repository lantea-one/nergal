@using Nergal.Core.Identity
@model Nergal.Web.OidcConnectionPageModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Nergal.Web.UiStrings> L
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["LocalizedContent"] = true;
    ViewData["Title"] = "Identity provider connection";
    ViewData["ActiveNav"] = "settings";
    var saved = Model.Connection;
    var s = saved?.Settings;
    var assurance = s?.MfaAssuranceMode ?? OidcMfaAssuranceMode.Deny;
    var local = User.FindFirst(Nergal.Core.Identity.ControllerActorIdentity.ActorClaimType)?.Value.StartsWith("local:", StringComparison.Ordinal) == true;
}
<main id="main-content" tabindex="-1" class="container">
    <div class="page-header"><div><h1>@L["Identity provider connection"]</h1><p class="muted">@L["Configure one OpenID Connect provider. Local sign-in remains available."]</p></div></div>
    <p><a href="@Url.Content("~/manage/settings#auth")">@L["Back to settings"]</a> · <a href="@Url.Content("~/manage/identity/profiles")">@L["Profile field mappings"]</a></p>
    @if (Model.Error is not null) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
    @if (!local) { <div class="alert alert-warning" role="status">@L["Sign in as a local Administrator to change provider trust or credentials."]</div> }
    <section class="card">
        <h2>@L["Connection settings"]</h2>
        <p class="muted">@(saved is null ? L["No UI-managed connection has been saved. Protected startup configuration may supply an initial connection."] : L["Saved connection settings take effect on the next request."])</p>
        @if (saved is not null) { <p class="muted">@L["Updated"] <time datetime="@saved.UpdatedUtc.ToString("O")" data-local-time>@saved.UpdatedUtc.ToString("O")</time> · @L["Version {0}", saved.Version]</p> }
        <form method="post" action="@Url.Content("~/manage/identity/connection/save")" class="form-stack">
            @Html.AntiForgeryToken()
            <input type="hidden" name="version" value="@(saved?.Version ?? 0)" />
            <div class="form-grid">
                <div class="field"><span class="switch-field-label">@L["Provider sign-in"]</span>@await Html.PartialAsync("_EnablementSwitch", new Nergal.Web.EnablementSwitchModel("enabled", s?.Enabled ?? false, L["Enable OpenID Connect sign-in"].Value, Disabled: !local))<small class="muted">@L["Enable after entering the provider details. Disabling retains them."]</small></div>
                <div class="field span-2"><label for="provider-issuer">@L["Issuer URL"]</label><input id="provider-issuer" type="url" name="issuer" value="@s?.Issuer" placeholder="https://identity.example.test/realms/example" maxlength="512" required disabled="@(!local)" /><small class="muted">@L["Exact HTTPS issuer from provider discovery; no query or fragment."]</small></div>
                <div class="field"><label for="provider-client">@L["Client ID"]</label><input id="provider-client" name="clientId" value="@s?.ClientId" maxlength="256" required disabled="@(!local)" /></div>
                <div class="field span-2"><label for="provider-callback">@L["Registered callback URL"]</label><input id="provider-callback" name="callbackUri" type="url" value="@s?.CallbackUri" placeholder="https://firewall.example.test/signin-oidc" maxlength="512" required disabled="@(!local)" /><small class="muted">@L["Register this exact HTTPS URL at the provider. The path must be /signin-oidc."]</small></div>
                <div class="field span-2"><label for="provider-secret">@(saved?.HasSecret == true ? L["Replacement client secret (optional)"] : L["Client secret"])</label><input id="provider-secret" type="password" name="clientSecret" autocomplete="new-password" maxlength="4096" disabled="@(!local)" /><small class="muted">@(saved?.HasSecret == true ? L["A secret is stored. Leave blank to retain it for the same issuer and client ID."] : L["Enter the confidential client's secret. It is encrypted at rest and never shown again."]) @L["Changing issuer or client ID requires a new secret."]</small></div>
            </div>
            <h3>@L["Access groups"]</h3><p class="muted">@L["Group membership must come from the signed ID token. Values match exactly, including case. Supply at least one role group."]</p>
            <div class="form-grid">
                <div class="field"><label for="provider-claim">@L["Groups claim"]</label><input id="provider-claim" name="groupClaim" value="@(s?.GroupClaim ?? "groups")" maxlength="128" required disabled="@(!local)" /><small class="muted">@L["Literal top-level claim name; expressions and nested lookups are unsupported."]</small></div>
                <div class="field span-2"><label for="provider-admins">@L["Administrator groups"]</label><textarea id="provider-admins" name="administratorGroups" rows="3" maxlength="8224" disabled="@(!local)">@string.Join("\n", s?.AdministratorGroups ?? [])</textarea><small class="muted">@L["One exact group per line, up to 32. No wildcards."]</small></div>
                <div class="field"><label for="provider-auditors">@L["Auditor groups"]</label><textarea id="provider-auditors" name="auditorGroups" rows="3" maxlength="8224" disabled="@(!local)">@string.Join("\n", s?.AuditorGroups ?? [])</textarea><small class="muted">@L["One per line. A group cannot appear in both roles."]</small></div>
            </div>
            <h3>@L["MFA assurance"]</h3>
            <div class="form-grid">
                <div class="field span-2">
                    <label for="provider-mfa-mode">@L["When MFA is required for the signed-in role"]</label>
                    <select id="provider-mfa-mode" name="mfaAssuranceMode" aria-describedby="provider-mfa-hint" disabled="@(!local)">
                        <option value="Deny" selected="@(assurance == OidcMfaAssuranceMode.Deny)">@L["Deny provider sign-in"]</option>
                        <option value="ProviderBypass" selected="@(assurance == OidcMfaAssuranceMode.ProviderBypass)">@L["Trust the provider to enforce MFA"]</option>
                        <option value="SignedClaim" selected="@(assurance == OidcMfaAssuranceMode.SignedClaim)">@L["Require a signed ID-token claim"]</option>
                    </select>
                    <small class="muted" id="provider-mfa-hint">@L["Choose provider trust only if the provider enforces MFA for this connection. Roles with optional MFA can sign in under any mode."]</small>
                </div>
                <div class="field">
                    <label for="provider-mfa-claim">@L["Assurance claim"]</label>
                    <input id="provider-mfa-claim" name="mfaAssuranceClaim" value="@s?.MfaAssuranceClaim" maxlength="128" placeholder="amr" aria-describedby="provider-mfa-claim-hint" disabled="@(!local)" />
                    <small class="muted" id="provider-mfa-claim-hint">@L["Signed-claim mode only. Enter a literal top-level claim name, separate from the groups claim."]</small>
                </div>
                <div class="field">
                    <label for="provider-mfa-value">@L["Expected assurance value"]</label>
                    <input id="provider-mfa-value" name="mfaAssuranceValue" value="@s?.MfaAssuranceValue" maxlength="256" placeholder="mfa" aria-describedby="provider-mfa-value-hint" disabled="@(!local)" />
                    <small class="muted" id="provider-mfa-value-hint">@L["Match the exact case-sensitive string or one item in an array of distinct strings. Leave both claim fields blank in other modes."]</small>
                </div>
            </div>
            <div class="alert alert-warning">@L["Saving replaces the active connection settings, invalidates existing provider sessions and cancels in-flight provider sign-ins. Local sessions remain available. No provider request is made until sign-in."]</div>
            <div><button type="submit" name="confirm" value="replace-trust" disabled="@(!local)">@L["Save and replace provider settings"]</button></div>
        </form>
    </section>
</main>

@using Nergal.Core.Policy

@if (Bundle is not null)
{
    <section class="card" aria-label="Structured policy bundle summary">
        <div class="card-header">
            <h2>Bundle summary</h2>
            <div class="btn-group">
                <span class="badge badge-primary">Filter v@(Bundle.Filter.SchemaVersion) (@Bundle.Filter.Rules.Count rules)</span>
                @if (Bundle.Nat is { } natBadge)
                {
                    <span class="badge badge-warning">NAT (@(natBadge.DnatRules.Count + natBadge.SnatRules.Count) rules)</span>
                }
                @if (Bundle.Bridge is { } brBadge)
                {
                    <span class="badge badge-neutral">Bridge (@brBadge.Rules.Count rules)</span>
                }
            </div>
        </div>

        <p class="muted">Disabled rules below retain intent but do not enforce traffic policy. Native observations contain active rules only.</p>
        <p class="muted" style="margin-top: 0;">
            Filter defaults — Input: <code>@Bundle.Filter.InputDefaultVerdict.ToString().ToLowerInvariant()</code> ·
            Forward: <code>@Bundle.Filter.ForwardDefaultVerdict.ToString().ToLowerInvariant()</code> ·
            Output: <code>@Bundle.Filter.OutputDefaultVerdict.ToString().ToLowerInvariant()</code>
        </p>

        @if (Bundle.Filter.Rules.Count == 0)
        {
            <p class="muted">No filter rules defined.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="policy-rules-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Chain</th>
                            <th>Family</th>
                            <th>Protocol / ICMP</th>
                            <th>Source</th>
                            <th>Destination</th>
                            <th>Ports</th>
                            <th>Interfaces</th>
                            <th>States / Match</th>
                            <th>Rate Limit</th>
                            <th>Enabled state</th><th>Verdict</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Bundle.Filter.Rules.Count; i++)
                        {
                            var rule = Bundle.Filter.Rules[i];
                            if (rule is null) { continue; }
                            <tr>
                                <td>@(i + 1)</td>
                                <td><code>@rule.Chain.ToString().ToLowerInvariant()</code></td>
                                <td><code>@rule.Family.ToString().ToLowerInvariant()</code></td>
                                <td>
                                    <code>@rule.Protocol.ToString().ToLowerInvariant()</code>
                                    @if (!string.IsNullOrEmpty(rule.IcmpType))
                                    {
                                        <span>(<code>@rule.IcmpType</code>)</span>
                                    }
                                </td>
                                <td><code>@(rule.NegateSource ? "!= " : "")@(ObjectLabel(rule.SourceObject) ?? FormatPrefixes(rule.Source, rule.SourcePrefixes))</code>
                                    @if (rule.SourceMac is not null || rule.SourceMacs is not null)
                                    { <span class="rule-desc">MAC @(rule.NegateSourceMac ? "!= " : "")@(rule.SourceMac?.Value ?? string.Join(", ", rule.SourceMacs!.Select(m => m.Value)))</span> }
                                </td>
                                <td><code>@(rule.NegateDestination ? "!= " : "")@(ObjectLabel(rule.DestinationObject) ?? FormatPrefixes(rule.Destination, rule.DestinationPrefixes))</code></td>
                                <td><code>@(ObjectLabel(rule.DestinationPortObject) ?? FormatPorts(rule.DestinationPort, rule.DestinationPorts))</code></td>
                                <td><code>@FormatInterfaces(rule.InputInterface is null ? null : (rule.NegateInputInterface ? "!= " : "") + rule.InputInterface, rule.OutputInterface is null ? null : (rule.NegateOutputInterface ? "!= " : "") + rule.OutputInterface)</code>
                                    @if (rule.BindInputInterfaceIndex) { <span class="rule-desc">Input interface bound by index</span> }
                                </td>
                                <td>
                                    <code>@FormatStates(rule.ConnectionStates)</code>
                                    @if (rule.MatchOriginalDestinationDnat)
                                    {
                                        <span class="badge badge-warning">ct dnat</span>
                                    }
                                    @if (rule.OriginalSourcePrefixes is { } originalSources)
                                    { <span class="rule-desc">Original source @string.Join(", ", originalSources.Select(p => p.Value))</span> }
                                    @if (rule.OriginalDestinationPrefixes is { } originalDestinations)
                                    { <span class="rule-desc">Original destination @string.Join(", ", originalDestinations.Select(p => p.Value))</span> }
                                </td>
                                <td><code>@FormatRateLimit(rule.RateLimit)</code></td>
                                <td>@(rule.Enabled ? "Enabled" : "Disabled · omitted")</td>
                                <td>
                                    <span class="badge @(rule.Verdict == FilterVerdict.Accept ? "badge-success" : "badge-danger")">
                                        @rule.Verdict.ToString().ToLowerInvariant()
                                    </span>
                                    @if (rule.CountPackets) { <span class="muted">counter</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <details class="disclosure"><summary>All authored rule states</summary>
            <ul>@foreach (var state in PolicyRuleStates.Enumerate(Bundle)) { <li>@state.Label: <strong>@(state.Enabled ? "Enabled" : "Disabled · omitted")</strong></li> }</ul>
        </details>
        @if (Bundle.Filter.RpFilter is { } rp)
        { <p>Raw rpfilter: @rp.Rules.Count rules.</p> }
        @if (Bundle.Filter.RawOutput is { } rawOutput)
        { <p>Raw output: @rawOutput.Rules.Count rules.</p> }
        @if (Bundle.Filter.ForwardTcpMssClamp is { } mss)
        { <p>Forward TCP SYN MSS clamp: @mss bytes · @(Bundle.Filter.ForwardTcpMssClampEnabled ? "Enabled" : "Disabled · omitted").</p> }
        @if (Bundle.RequiresExtendedApplySupport)
        { <p class="alert alert-info">Auxiliary/extended bridge scope requires complete bundle receipts. Confirmed apply and local rollback cover all owned tables; unexpected drift requires recovery.</p> }
        @if (Bundle.Nat is { } nat)
        {
            <h3>NAT (<code>inet nergal_nat</code>)</h3>
            <p class="muted">Prerouting DNAT rules: <strong>@nat.DnatRules.Count(rule => rule?.Hook == DnatHook.Prerouting)</strong> · Output DNAT rules: <strong>@nat.DnatRules.Count(rule => rule?.Hook == DnatHook.Output)</strong> · Postrouting rules: <strong>@nat.SnatRules.Count</strong></p>
        }

        @if (Bundle.Bridge is { } bridge)
        {
            <h3>Bridge (<code>bridge nergal_bridge</code>)</h3>
            <p class="muted mb-0">Default verdict: <code>@bridge.DefaultVerdict.ToString().ToLowerInvariant()</code> · Forward rules: <strong>@bridge.Rules.Count</strong> · Priority: <code>@bridge.Priority</code> · Regular chains: <strong>@bridge.SubChains.Count</strong></p>
        }
    </section>
}

@code {
    private static string? ObjectLabel(PolicyObjectReference? reference) => reference is null ? null : reference.Content.Name + " v" + reference.Version + " [" + string.Join(", ", reference.Content.Entries) + "]";
    /// <summary>Gets or sets the decoded policy bundle to render.</summary>
    [Parameter]
    public FirewallPolicyBundle? Bundle { get; set; }

    private static string FormatPrefixes(NetworkPrefix? single, IReadOnlyList<NetworkPrefix>? set)
    {
        if (single is not null) { return single.Value; }
        if (set is { Count: > 0 }) { return "{ " + string.Join(", ", set.Select(p => p.Value)) + " }"; }
        return "any";
    }

    private static string FormatPorts(int? single, IReadOnlyList<int>? set)
    {
        if (single.HasValue) { return single.Value.ToString(System.Globalization.CultureInfo.InvariantCulture); }
        if (set is { Count: > 0 }) { return "{ " + string.Join(", ", set) + " }"; }
        return "any";
    }

    private static string FormatInterfaces(string? iif, string? oif)
    {
        if (iif is null && oif is null) { return "any"; }
        if (iif is not null && oif is not null) { return $"in:{iif} out:{oif}"; }
        return iif is not null ? $"in:{iif}" : $"out:{oif}";
    }

    private static string FormatStates(ConnectionStateFlags states)
    {
        if (states == ConnectionStateFlags.None) { return "stateless"; }
        var parts = new List<string>(4);
        if ((states & ConnectionStateFlags.New) != 0) { parts.Add("new"); }
        if ((states & ConnectionStateFlags.Established) != 0) { parts.Add("established"); }
        if ((states & ConnectionStateFlags.Related) != 0) { parts.Add("related"); }
        if ((states & ConnectionStateFlags.Invalid) != 0) { parts.Add("invalid"); }
        if ((states & ConnectionStateFlags.Untracked) != 0) { parts.Add("untracked"); }
        return string.Join(", ", parts);
    }

    private static string FormatRateLimit(PerSourceRateLimit? rl)
    {
        if (rl is null) { return "—"; }
        var unit = rl.WindowUnit == RateLimitTimeUnit.Second ? "s" : "m";
        return $"{rl.PacketsPerWindow}/{unit} per {(rl.KeyKind == RateLimitKeyKind.DestinationAddress ? "destination" : "source")} (burst {rl.Burst}, {rl.EntryTimeoutSeconds}s, {(rl.RefreshEntryTimeout ? "refresh idle expiry" : "creation expiry")})";
    }
}

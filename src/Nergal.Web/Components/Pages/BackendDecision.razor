@page "/backend-decision"
@using Nergal.Core

<PageTitle>Backend decision · nergal</PageTitle>

<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">N</span>
            <span>nergal</span>
        </a>
        <div class="topbar-meta">
            <a class="nav-link" href="/">Home</a>
            <button type="button" class="btn btn-secondary btn-sm" data-theme-toggle>Theme</button>
        </div>
    </div>
</header>

<main class="container">
    <div class="page-header">
        <div>
            <h1>Native nftables first</h1>
            <p class="page-subtitle">Architectural rationale for targeting native Linux <code>nftables</code> without partial translation adapters.</p>
        </div>
        <span class="badge badge-primary">ADR 0001</span>
    </div>

    <div class="card">
        <h2>Backend design &amp; guarantees</h2>
        <p class="muted">
            nergal compiles typed policy bundles directly into owned <code>inet nergal_filter</code>,
            <code>inet nergal_nat</code>, and <code>bridge nergal_bridge</code> tables with atomic candidate validation
            and independent local watchdog rollback. Foreign tables are never flushed or modified.
        </p>
        <div class="btn-group mt-2">
            <span class="badge badge-success">Dual-stack inet filtering</span>
            <span class="badge badge-success">Explicit DNAT / SNAT</span>
            <span class="badge badge-success">L2 Bridge filtering</span>
            <span class="badge badge-success">Inline CIDR &amp; port sets</span>
            <span class="badge badge-success">Per-source dynamic rate limits</span>
            <span class="badge badge-success">Foreign table preservation</span>
        </div>
    </div>
</main>

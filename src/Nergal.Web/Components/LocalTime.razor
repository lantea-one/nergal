@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizer<Nergal.Web.UiStrings> L
<time data-local-time datetime="@UtcInstant" title="@(L["Stored UTC: {0}", UtcInstant].Value)">@Value.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", CultureInfo.InvariantCulture)</time>

@code {
    /// <summary>The stored instant; the shared browser formatter displays local time without changing this UTC representation.</summary>
    [Parameter] public DateTimeOffset Value { get; set; }
    private string UtcInstant => Value.UtcDateTime.ToString("O", CultureInfo.InvariantCulture);
}
